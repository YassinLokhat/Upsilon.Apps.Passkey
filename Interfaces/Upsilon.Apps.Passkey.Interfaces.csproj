<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>A local stored Password Manager Interfaces.</Description>
    <Version>2.0.0</Version>
    <AssemblyVersion>2.0.0</AssemblyVersion>
    <FileVersion>2.0.0</FileVersion>
  </PropertyGroup>

  <!-- Zero-dependency: fail the build if any PackageReference appears. See CONTRIBUTING.md. -->
  <Target Name="EnforceZeroExternalDependencies" BeforeTargets="Build;Pack">
    <Error Condition="'@(PackageReference)' != ''"
           Text="Zero-dependency policy violated in '$(MSBuildProjectName)': external NuGet packages are not allowed (found: @(PackageReference))." />
  </Target>

</Project>
