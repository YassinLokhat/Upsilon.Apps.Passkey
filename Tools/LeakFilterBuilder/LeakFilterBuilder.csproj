<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Upsilon.Apps.Passkey.Tools.LeakFilterBuilder</RootNamespace>
    <AssemblyName>Passkey.LeakFilterBuilder</AssemblyName>
    <Description>Builds the offline HIBP SHA-1 Bloom filter (.pkbf) for Upsilon.Apps.Passkey.</Description>
    <Version>2.0.0</Version>
    <!-- CLI tool: console I/O literals and broad catch at Main are intentional. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CA1303;CA1849;CA1031</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Utils\Upsilon.Apps.Passkey.Utils.csproj" />
  </ItemGroup>

</Project>
