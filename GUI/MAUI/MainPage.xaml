<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Upsilon.Apps.Passkey.GUI.Presentation.ViewModels;assembly=Upsilon.Apps.Passkey.GUI.Presentation"
             xmlns:loc="clr-namespace:Upsilon.Apps.Passkey.GUI.MAUI.Localization"
             x:Class="Upsilon.Apps.Passkey.GUI.MAUI.MainPage"
             xmlns:pages="clr-namespace:Upsilon.Apps.Passkey.GUI.MAUI.Pages"
             x:ClassModifier="internal"
             pages:WindowMinimumSize.Width="560"
             pages:WindowMinimumSize.Height="480"
             x:DataType="viewmodels:LoginViewModel"
             Title="{Binding Title}">

   <ScrollView>
      <VerticalStackLayout Padding="30,0" Spacing="16" VerticalOptions="Center">

         <Label Text="{Binding SelectedVaultLabel}"
                IsVisible="{Binding HasSelectedVault}" />

         <Label Text="{Binding CredentialsLabel}"
                Style="{StaticResource SubHeadline}" />

         <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <!-- Passkey/username: never TwoWay-bound to a secret property. Autofill off. -->
            <Entry x:Name="CredentialEntry"
                   Grid.Column="0"
                   MaxLength="256"
                   IsPassword="{Binding DatabaseOpened}"
                   IsEnabled="{Binding IsIdle}"
                   IsTextPredictionEnabled="False"
                   IsSpellCheckEnabled="False"
                   ReturnType="Done"
                   Completed="_onCredentialCompleted"
                   TextChanged="_onCredentialTextChanged" />
            <Button Text="{loc:Loc Login_Next}"
                 Grid.Column="1"
                 IsEnabled="{Binding IsIdle}"
                 Clicked="_onCredentialCompleted" />
            <Button Text="{loc:Loc Login_Reset}"
                 Grid.Column="2"
                 IsEnabled="{Binding IsIdle}"
                 Clicked="_onReset" />
         </Grid>

         <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
            <Button Grid.Row="0" Grid.Column="0"
                    Text="{loc:Loc Menu_OpenDatabase}"
                    IsEnabled="{Binding MenusEnabled}"
                    Clicked="_onPickVault" />
            <Button Grid.Row="0" Grid.Column="1"
                    Text="{loc:Loc Menu_NewUser}"
                    Command="{Binding NewUserCommand}" />
            <Button Grid.Row="1" Grid.Column="0"
                    Text="{loc:Loc Menu_GenerateRandomPassword}"
                    Command="{Binding GeneratePasswordCommand}" />
            <Button Grid.Row="1" Grid.Column="1"
                    Text="{loc:Loc Menu_AppSettings}"
                    Command="{Binding AppSettingsCommand}" />
         </Grid>

         <ActivityIndicator IsRunning="{Binding IsBusy}"
                            IsVisible="{Binding IsBusy}" />

         <Label Text="{Binding StatusMessage}"
                LineBreakMode="WordWrap" />

         <Label Text="{Binding ConflictCopiesMessage}"
                IsVisible="{Binding HasConflictCopies}"
                LineBreakMode="WordWrap" />
         <Button Text="{loc:Loc Button_SaveConflictCopies}"
                 IsVisible="{Binding HasConflictCopies}"
                 Command="{Binding SaveConflictCopiesCommand}" />

      </VerticalStackLayout>
   </ScrollView>
</ContentPage>
