<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Upsilon.Apps.Passkey.GUI.Presentation.ViewModels;assembly=Upsilon.Apps.Passkey.GUI.Presentation"
             xmlns:loc="clr-namespace:Upsilon.Apps.Passkey.GUI.MAUI.Localization"
             x:Class="Upsilon.Apps.Passkey.GUI.MAUI.MainPage"
             x:ClassModifier="internal"
             x:DataType="viewmodels:LoginViewModel"
             Title="{Binding Title}">

   <ContentPage.MenuBarItems>
      <MenuBarItem Text="{loc:Loc Menu_Vault}">
         <MenuFlyoutItem Text="{loc:Loc Menu_OpenDatabase}" IsEnabled="{Binding MenusEnabled}" Clicked="_onPickVault">
            <MenuFlyoutItem.KeyboardAccelerators>
               <KeyboardAccelerator Modifiers="Ctrl" Key="O" />
            </MenuFlyoutItem.KeyboardAccelerators>
         </MenuFlyoutItem>
         <MenuFlyoutItem Text="{loc:Loc Menu_NewUser}" Command="{Binding NewUserCommand}">
            <MenuFlyoutItem.KeyboardAccelerators>
               <KeyboardAccelerator Modifiers="Ctrl" Key="N" />
            </MenuFlyoutItem.KeyboardAccelerators>
         </MenuFlyoutItem>
         <MenuFlyoutItem Text="{loc:Loc Menu_GenerateRandomPassword}" Command="{Binding GeneratePasswordCommand}">
            <MenuFlyoutItem.KeyboardAccelerators>
               <KeyboardAccelerator Modifiers="Ctrl" Key="P" />
            </MenuFlyoutItem.KeyboardAccelerators>
         </MenuFlyoutItem>
      </MenuBarItem>
      <MenuBarItem Text="{loc:Loc Menu_AppSettings}">
         <MenuFlyoutItem Text="{loc:Loc Menu_AppSettings}" Command="{Binding AppSettingsCommand}">
            <MenuFlyoutItem.KeyboardAccelerators>
               <KeyboardAccelerator Modifiers="Ctrl" Key="OemComma" />
            </MenuFlyoutItem.KeyboardAccelerators>
         </MenuFlyoutItem>
      </MenuBarItem>
   </ContentPage.MenuBarItems>

   <ScrollView>
      <VerticalStackLayout Padding="30,0" Spacing="16" VerticalOptions="Center">

         <Label Text="{Binding SelectedVaultLabel}"
                IsVisible="{Binding HasSelectedVault}" />

         <Label Text="{Binding CredentialsLabel}"
                Style="{StaticResource SubHeadline}" />

         <!-- Passkey/username: never TwoWay-bound to a secret property. Autofill off. -->
         <Entry x:Name="CredentialEntry"
                MaxLength="256"
                IsPassword="{Binding DatabaseOpened}"
                IsEnabled="{Binding IsIdle}"
                IsTextPredictionEnabled="False"
                IsSpellCheckEnabled="False"
                ReturnType="Done"
                Completed="_onCredentialCompleted"
                TextChanged="_onCredentialTextChanged" />

         <ActivityIndicator IsRunning="{Binding IsBusy}"
                            IsVisible="{Binding IsBusy}" />

         <Label Text="{Binding StatusMessage}"
                LineBreakMode="WordWrap" />

         <Button Text="{loc:Loc Login_Next}"
                 IsEnabled="{Binding IsIdle}"
                 Clicked="_onCredentialCompleted" />
         <Button Text="{loc:Loc Login_OpenVault}"
                 IsEnabled="{Binding IsIdle}"
                 Clicked="_onPickVault" />
         <Button Text="{loc:Loc Login_Reset}"
                 IsEnabled="{Binding IsIdle}"
                 Clicked="_onReset" />

         <Label Text="{Binding ConflictCopiesMessage}"
                IsVisible="{Binding HasConflictCopies}"
                LineBreakMode="WordWrap" />
         <Button Text="{loc:Loc Button_SaveConflictCopies}"
                 IsVisible="{Binding HasConflictCopies}"
                 Command="{Binding SaveConflictCopiesCommand}" />

      </VerticalStackLayout>
   </ScrollView>
</ContentPage>
