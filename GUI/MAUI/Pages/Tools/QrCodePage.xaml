<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:Upsilon.Apps.Passkey.GUI.MAUI.Localization"
             x:Class="Upsilon.Apps.Passkey.GUI.MAUI.Pages.Tools.QrCodePage"
             x:ClassModifier="internal"
             BackgroundColor="White">
   <Grid Padding="24" RowDefinitions="*,Auto" RowSpacing="12">
      <GraphicsView x:Name="QrView" Grid.Row="0" />
      <Button Grid.Row="1" Text="{loc:Loc Button_OK}" Clicked="_onClose" />
   </Grid>
</ContentPage>
