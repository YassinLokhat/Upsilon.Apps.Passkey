<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:tools="clr-namespace:Upsilon.Apps.Passkey.GUI.Presentation.ViewModels.Tools;assembly=Upsilon.Apps.Passkey.GUI.Presentation"
             xmlns:loc="clr-namespace:Upsilon.Apps.Passkey.GUI.MAUI.Localization"
             x:Class="Upsilon.Apps.Passkey.GUI.MAUI.Pages.Tools.CredentialsConfirmationPage"
             x:ClassModifier="internal"
             x:DataType="tools:CredentialsConfirmationViewModel"
             Title="{Binding Title}">
   <VerticalStackLayout Padding="30,20" Spacing="16" VerticalOptions="Center">
      <Label Text="{Binding CredentialsLabel}" Style="{StaticResource SubHeadline}" />

      <!-- Never bound to a ViewModel property: the text is read once on Completed, then cleared. -->
      <Entry x:Name="CredentialEntry"
             MaxLength="256"
             IsPassword="{Binding IsAwaitingPasskeys}"
             IsTextPredictionEnabled="False"
             IsSpellCheckEnabled="False"
             Completed="_onCompleted" />

      <HorizontalStackLayout Spacing="8">
         <Button Text="{loc:Loc Tooltip_Clear}" Clicked="_onReset" />
         <Button Text="{loc:Loc Button_Cancel}" Clicked="_onCancel" />
      </HorizontalStackLayout>
   </VerticalStackLayout>
</ContentPage>
