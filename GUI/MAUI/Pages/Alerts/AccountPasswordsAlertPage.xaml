<?xml version="1.0" encoding="utf-8" ?>
<pages:ClosablePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:pages="clr-namespace:Upsilon.Apps.Passkey.GUI.MAUI.Pages"
                    xmlns:alerts="clr-namespace:Upsilon.Apps.Passkey.GUI.Presentation.ViewModels.Alerts;assembly=Upsilon.Apps.Passkey.GUI.Presentation"
                    xmlns:loc="clr-namespace:Upsilon.Apps.Passkey.GUI.MAUI.Localization"
                    x:Class="Upsilon.Apps.Passkey.GUI.MAUI.Pages.Alerts.AccountPasswordsAlertPage"
                    x:ClassModifier="internal"
                    x:DataType="alerts:AccountPasswordsAlertViewModel"
                    Title="{Binding Title}">
   <Grid Padding="16" RowSpacing="8" RowDefinitions="Auto,Auto,*,Auto">
      <Picker Grid.Row="0" ItemsSource="{Binding KindOptions}" SelectedItem="{Binding ReadableAlertKind}" />
      <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
         <Entry Text="{Binding Text}" IsTextPredictionEnabled="False" IsSpellCheckEnabled="False" />
         <Button Grid.Column="1" Text="{loc:Loc Tooltip_Clear}" Command="{Binding ClearFiltersCommand}" />
      </Grid>

      <CollectionView Grid.Row="2" ItemsSource="{Binding Alerts}">
         <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="alerts:AccountPasswordAlertViewModel">
               <VerticalStackLayout Padding="0,6">
                  <VerticalStackLayout.GestureRecognizers>
                     <TapGestureRecognizer Command="{Binding GoToCommand}" />
                  </VerticalStackLayout.GestureRecognizers>
                  <Label Text="{Binding ReadableAlertKind}" FontAttributes="Bold" />
                  <Label>
                     <Label.FormattedText>
                        <FormattedString>
                           <Span Text="{Binding ServiceString}" />
                           <Span Text=" / " />
                           <Span Text="{Binding AccountString}" />
                        </FormattedString>
                     </Label.FormattedText>
                  </Label>
               </VerticalStackLayout>
            </DataTemplate>
         </CollectionView.ItemTemplate>
      </CollectionView>

      <Button Grid.Row="3" Text="{loc:Loc Button_OK}" Clicked="_onClose" />
   </Grid>
</pages:ClosablePage>
