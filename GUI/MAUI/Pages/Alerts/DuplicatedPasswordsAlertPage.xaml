<?xml version="1.0" encoding="utf-8" ?>
<pages:ClosablePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:pages="clr-namespace:Upsilon.Apps.Passkey.GUI.MAUI.Pages"
                    xmlns:alerts="clr-namespace:Upsilon.Apps.Passkey.GUI.Presentation.ViewModels.Alerts;assembly=Upsilon.Apps.Passkey.GUI.Presentation"
                    xmlns:loc="clr-namespace:Upsilon.Apps.Passkey.GUI.MAUI.Localization"
                    x:Class="Upsilon.Apps.Passkey.GUI.MAUI.Pages.Alerts.DuplicatedPasswordsAlertPage"
                    x:ClassModifier="internal"
                    x:DataType="alerts:DuplicatedPasswordsAlertViewModel"
                    Title="{Binding Title}">
   <Grid Padding="16" RowSpacing="8" RowDefinitions="*,Auto">
      <CollectionView ItemsSource="{Binding Alerts}">
         <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="alerts:DuplicatedPasswordAlertViewModel">
               <VerticalStackLayout Padding="0,8" Spacing="4">
                  <Label Text="{Binding DuplicatedPassword}" FontAttributes="Bold" />
                  <VerticalStackLayout BindableLayout.ItemsSource="{Binding Accounts}">
                     <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="alerts:AccountPasswordAlertViewModel">
                           <Label Padding="12,4">
                              <Label.GestureRecognizers>
                                 <TapGestureRecognizer Command="{Binding GoToCommand}" />
                              </Label.GestureRecognizers>
                              <Label.FormattedText>
                                 <FormattedString>
                                    <Span Text="{Binding ServiceString}" />
                                    <Span Text=" / " />
                                    <Span Text="{Binding AccountString}" />
                                 </FormattedString>
                              </Label.FormattedText>
                           </Label>
                        </DataTemplate>
                     </BindableLayout.ItemTemplate>
                  </VerticalStackLayout>
               </VerticalStackLayout>
            </DataTemplate>
         </CollectionView.ItemTemplate>
      </CollectionView>

      <Button Grid.Row="1" Text="{loc:Loc Button_OK}" Clicked="_onClose" />
   </Grid>
</pages:ClosablePage>
