<?xml version="1.0" encoding="utf-8" ?>
<pages:ClosablePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:pages="clr-namespace:Upsilon.Apps.Passkey.GUI.MAUI.Pages"
                    xmlns:alerts="clr-namespace:Upsilon.Apps.Passkey.GUI.Presentation.ViewModels.Alerts;assembly=Upsilon.Apps.Passkey.GUI.Presentation"
                    xmlns:loc="clr-namespace:Upsilon.Apps.Passkey.GUI.MAUI.Localization"
                    x:Class="Upsilon.Apps.Passkey.GUI.MAUI.Pages.Alerts.IssuesAlertPage"
                    x:ClassModifier="internal">
   <Grid Padding="16" RowSpacing="8" RowDefinitions="*,Auto">
      <CollectionView x:Name="IssuesList">
         <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="alerts:IssueItemViewModel">
               <VerticalStackLayout Padding="0,8" Spacing="2">
                  <Label Text="{Binding Title}" FontAttributes="Bold" />
                  <Label Text="{Binding Description}" LineBreakMode="WordWrap" />
               </VerticalStackLayout>
            </DataTemplate>
         </CollectionView.ItemTemplate>
      </CollectionView>

      <Button Grid.Row="1" Text="{loc:Loc Button_OK}" Clicked="_onClose" />
   </Grid>
</pages:ClosablePage>
