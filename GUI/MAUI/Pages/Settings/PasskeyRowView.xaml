<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:settings="clr-namespace:Upsilon.Apps.Passkey.GUI.Presentation.ViewModels.Settings;assembly=Upsilon.Apps.Passkey.GUI.Presentation"
             xmlns:conv="clr-namespace:Upsilon.Apps.Passkey.GUI.MAUI.Converters"
             xmlns:loc="clr-namespace:Upsilon.Apps.Passkey.GUI.MAUI.Localization"
             x:Class="Upsilon.Apps.Passkey.GUI.MAUI.Pages.Settings.PasskeyRowView"
             x:ClassModifier="internal"
             x:DataType="settings:PasskeyEntryViewModel">
   <ContentView.Resources>
      <conv:FieldVisualStateColorConverter x:Key="StateColor" />
   </ContentView.Resources>

   <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="4">
      <!-- Not bound: the secret moves through ISecretInput so the ViewModel never holds it as a string. -->
      <Entry x:Name="SecretEntry"
             IsPassword="True"
             MaxLength="256"
             IsTextPredictionEnabled="False"
             IsSpellCheckEnabled="False"
             TextColor="{Binding PasswordState, Converter={StaticResource StateColor}}" />
      <Button Grid.Column="1" Text="👁" Pressed="_onRevealPressed" Released="_onRevealReleased" />
      <Button Grid.Column="2" Text="▲" Command="{Binding UpCommand}" ToolTipProperties.Text="{loc:Loc Tooltip_MoveUp}" />
      <Button Grid.Column="3" Text="▼" Command="{Binding DownCommand}" ToolTipProperties.Text="{loc:Loc Tooltip_MoveDown}" />
      <Button Grid.Column="4" Text="✕" Command="{Binding DeleteCommand}" ToolTipProperties.Text="{loc:Loc Tooltip_DeletePassword}" />
   </Grid>
</ContentView>
