<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0-android</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <RootNamespace>Upsilon.Apps.Passkey.GUI.MAUI</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Enable XAML source generation for faster build times and improved performance. -->
    <MauiXamlInflator>SourceGen</MauiXamlInflator>

    <ApplicationTitle>Passkey</ApplicationTitle>
    <Description>A local stored Password Manager GUI.</Description>
    <ApplicationId>com.upsilon.apps.passkey</ApplicationId>

    <Version>2.0.0</Version>
    <AssemblyVersion>2.0.0</AssemblyVersion>
    <FileVersion>2.0.0</FileVersion>
    <ApplicationDisplayVersion>2.0.0</ApplicationDisplayVersion>
    <ApplicationVersion>2000000</ApplicationVersion>

    <!-- Unpackaged Windows host (zip distribution, same model as WPF). -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">29.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>

    <!-- Enforced by Directory.Build.targets with an allowlist. See CONTRIBUTING.md. -->
    <EnforceZeroExternalDependencies>true</EnforceZeroExternalDependencies>
    <AllowedExternalPackagePrefixes>Microsoft.Maui.</AllowedExternalPackagePrefixes>

    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>

    <!-- Keep in sync with LocalizationService.Shipped (Presentation satellites). -->
    <SatelliteResourceLanguages>en;fr</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Windows App SDK injects UndockedRegFreeWinRT-AutoInitializer.cs; its P/Invoke lacks
       DefaultDllImportSearchPaths. We cannot edit that generated file. -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <NoWarn>$(NoWarn);CA5392</NoWarn>
    <ApplicationIcon>..\..\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <!-- Loaded at runtime by MauiProgram for the window title bar and taskbar. -->
    <Content Include="..\..\icon.ico" Link="icon.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="..\..\icon.png" ForegroundScale="0.65" Color="#FFFFFF" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />
    <MauiImage Include="Resources\Images\*" />
    <MauiFont Include="Resources\Fonts\*" />
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pinned rather than $(MauiVersion): that follows the installed workload, which differs between machines and breaks locked restore. -->
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.110" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\Upsilon.Apps.Passkey.Core.csproj" />
    <ProjectReference Include="..\..\Utils\Upsilon.Apps.Passkey.Utils.csproj" />
    <ProjectReference Include="..\Presentation\Upsilon.Apps.Passkey.GUI.Presentation.csproj" />
  </ItemGroup>

</Project>
