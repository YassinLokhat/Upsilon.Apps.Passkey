<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Upsilon.Apps.Passkey.GUI.MAUI.ViewModels"
             x:Class="Upsilon.Apps.Passkey.GUI.MAUI.Views.ActivitiesPage"
             x:DataType="vm:ActivitiesViewModel"
             Title="{Binding Title}">
    <Grid Padding="12" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="8">
        <Label Grid.Row="0" Text="{Binding FiltersHeader}" />
        <VerticalStackLayout Grid.Row="1" Spacing="6">
            <Picker Title="Event type"
                    ItemsSource="{Binding EventTypeOptions}"
                    SelectedItem="{Binding SelectedEventType}" />
            <Entry Text="{Binding SearchText}" Placeholder="Search" />
            <HorizontalStackLayout>
                <Switch IsToggled="{Binding NeedsReviewOnly}" />
                <Label Text="Needs review only" VerticalOptions="Center" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
        <CollectionView Grid.Row="2" ItemsSource="{Binding Activities}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:ActivityRowViewModel">
                    <Border Padding="10" Margin="0,0,0,8" StrokeThickness="1">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding DateTimeText}" FontSize="12" Opacity="0.7" />
                            <Label Text="{Binding EventTypeText}" FontAttributes="Bold" />
                            <Label Text="{Binding Message}" LineBreakMode="WordWrap" />
                            <HorizontalStackLayout>
                                <Switch IsToggled="{Binding NeedsReview}" />
                                <Label Text="{Binding NeedsReviewLabel}" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <HorizontalStackLayout Grid.Row="3" Spacing="8">
            <Button Text="Refresh" Command="{Binding RefreshCommand}" />
            <Button Text="Back" Command="{Binding BackCommand}" />
        </HorizontalStackLayout>
    </Grid>
</ContentPage>
