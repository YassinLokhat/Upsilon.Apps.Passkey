<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Upsilon.Apps.Passkey.GUI.MAUI.ViewModels"
             x:Class="Upsilon.Apps.Passkey.GUI.MAUI.Views.PasswordGeneratorPage"
             x:DataType="vm:PasswordGeneratorViewModel"
             Title="{Binding Title}">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="10">
            <Entry Text="{Binding GeneratedPassword}" IsReadOnly="True" FontFamily="OpenSansSemibold" />
            <HorizontalStackLayout Spacing="8">
                <Button Text="Regenerate" Command="{Binding RegenerateCommand}" />
                <Button Text="Copy" Command="{Binding CopyCommand}" />
                <Button Text="Apply to account"
                        IsVisible="{Binding CanApplyToAccount}"
                        Command="{Binding ApplyToAccountCommand}" />
            </HorizontalStackLayout>
            <Label Text="{Binding StatusMessage}" FontSize="12" />

            <Label Text="Length" />
            <Stepper Minimum="4" Maximum="128" Increment="1" Value="{Binding PasswordLength}" />
            <Label Text="{Binding PasswordLength}" />

            <HorizontalStackLayout>
                <Switch IsToggled="{Binding IncludeNumerics}" />
                <Label Text="Numerics" VerticalOptions="Center" />
            </HorizontalStackLayout>
            <HorizontalStackLayout>
                <Switch IsToggled="{Binding IncludeLowerCaseAlphabet}" />
                <Label Text="Lowercase" VerticalOptions="Center" />
            </HorizontalStackLayout>
            <HorizontalStackLayout>
                <Switch IsToggled="{Binding IncludeUpperCaseAlphabet}" />
                <Label Text="Uppercase" VerticalOptions="Center" />
            </HorizontalStackLayout>
            <HorizontalStackLayout>
                <Switch IsToggled="{Binding IncludeSpecialCharacters}" />
                <Label Text="Special" VerticalOptions="Center" />
            </HorizontalStackLayout>
            <HorizontalStackLayout>
                <Switch IsToggled="{Binding CheckIfLeaked}" />
                <Label Text="Check if leaked" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Label Text="Alphabet" />
            <Entry Text="{Binding Alphabet}" />

            <Button Text="Back" Command="{Binding BackCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
