<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Upsilon.Apps.Passkey.GUI.MAUI.Views.QrCodeView"
             Title="QR Code"
             BackgroundColor="White">

    <Grid VerticalOptions="Center" HorizontalOptions="Center" WidthRequest="350" HeightRequest="350">
        <!-- GraphicsView remplace l'Image pour un rendu multiplateforme natif sans conversion de Bitmap -->
        <GraphicsView x:Name="_qrCodeGraphicsView" WidthRequest="350" HeightRequest="350" />
    </Grid>
</ContentPage>