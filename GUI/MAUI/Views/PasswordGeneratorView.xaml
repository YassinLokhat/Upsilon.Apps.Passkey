<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Upsilon.Apps.Passkey.GUI.WPF.Views.PasswordGenerator"
             xmlns:viewmodels="clr-namespace:Upsilon.Apps.Passkey.GUI.MAUI.ViewModels"
             x:DataType="viewmodels:PasswordGeneratorViewModel"
             Title="{Binding Title}">

    <Grid RowDefinitions="Auto, *">

        <!-- Barre d'en-tête modale (utile sur Mobile pour fermer sans valider) -->
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Padding="15,10" BackgroundColor="{AppThemeBinding Light=#F0F0F0, Dark=#1E1E1E}">
            <Label Text="Générateur de mot de passe"
                   FontAttributes="Bold"
                   FontSize="16"
                   VerticalOptions="Center" />

            <Button Grid.Column="1"
                    Text="✕"
                    FontSize="16"
                    HeightRequest="36"
                    WidthRequest="36"
                    CornerRadius="18"
                    Padding="0"
                    BackgroundColor="Transparent"
                    TextColor="{AppThemeBinding Light=Black, Dark=White}"
                    Clicked="OnCancelClicked" />
        </Grid>

        <!-- Contenu principal défilable -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="15" Spacing="15">

                <!-- Actions du haut : Générer, Fuite, Longueur -->
                <FlexLayout JustifyContent="SpaceBetween" AlignItems="Center">
                    <HorizontalStackLayout Spacing="10">
                        <Button Text="🔄" 
                                WidthRequest="45"
                                HeightRequest="40"
                                Padding="0"
                                Clicked="_regenerateMenuItem_Click" />

                        <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                            <CheckBox IsChecked="{Binding CheckIfLeaked}" x:Name="LeakedCheckBox" />
                            <Label Text="Leaked?" VerticalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnToggleLeakedTapped" />
                                </Label.GestureRecognizers>
                            </Label>
                        </HorizontalStackLayout>
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="5">
                        <Label Text="Length :" VerticalOptions="Center" />
                        <Entry WidthRequest="65"
                               HorizontalTextAlignment="Center"
                               Text="{Binding PasswordLength, Mode=TwoWay}"
                               TextChanged="_length_TextBox_TextChanged"
                               Keyboard="Numeric" />
                    </HorizontalStackLayout>
                </FlexLayout>

                <Line Stroke="Gray" StrokeThickness="1" HorizontalOptions="Fill" />

                <!-- Affichage du mot de passe généré -->
                <Entry FontSize="20"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="Center"
                       Text="{Binding GeneratedPassword, Mode=TwoWay}" />

                <!-- Options de caractères (FlexLayout multi-lignes pour mobiles) -->
                <FlexLayout Wrap="Wrap" JustifyContent="Start" AlignItems="Center">
                    <HorizontalStackLayout Margin="0,5,15,5">
                        <CheckBox IsChecked="{Binding IncludeNumerics}" />
                        <Label Text="0-9" VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Margin="0,5,15,5">
                        <CheckBox IsChecked="{Binding IncludeUpperCaseAlphabet}" />
                        <Label Text="A-Z" VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Margin="0,5,15,5">
                        <CheckBox IsChecked="{Binding IncludeLowerCaseAlphabet}" />
                        <Label Text="a-z" VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Margin="0,5,15,5">
                        <CheckBox IsChecked="{Binding IncludeSpecialCharacters}" />
                        <Label Text="!@#" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </FlexLayout>

                <!-- Jeu de caractères personnalisable -->
                <Editor HeightRequest="80"
                        AutoSize="Disabled"
                        FontSize="14"
                        Text="{Binding Alphabet, Mode=TwoWay}" />

                <!-- Boutons d'action du bas -->
                <Grid ColumnDefinitions="*, *" ColumnSpacing="10" Margin="0,10,0,0">
                    <Button Grid.Column="0" 
                            Text="Copier" 
                            Clicked="_copyMenuItem_Click" 
                            Visual="Outlined" />

                    <Button Grid.Column="1" 
                            Text="Utiliser" 
                            Clicked="OnSelectPasswordClicked" />
                </Grid>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>