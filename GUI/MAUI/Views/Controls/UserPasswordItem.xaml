<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Upsilon.Apps.Passkey.GUI.MAUI.ViewModels.Controls"
             xmlns:local="clr-namespace:Upsilon.Apps.Passkey.GUI.MAUI.Views.Controls"
             x:Class="Upsilon.Apps.Passkey.GUI.MAUI.Views.Controls.UserPasswordItem"
             x:DataType="controls:UserPasswordItemViewModel">

    <Grid ColumnDefinitions="Auto, *, Auto, Auto, Auto" 
          VerticalOptions="Center">
        
        <Label Grid.Column="0"
               Text="{Binding Index}"
               VerticalOptions="Center"
               Margin="5,0" />

        <local:VisiblePasswordBox x:Name="_password_VPB"
                                  Grid.Column="1"
                                  Margin="5" />

        <Button Grid.Column="2"
                Text="🠉"
                Clicked="_upButton_Click"
                WidthRequest="40"
                Margin="2" />

        <Button Grid.Column="3"
                Text="🠋"
                Clicked="_downButton_Click"
                WidthRequest="40"
                Margin="2" />

        <Button Grid.Column="4"
                Text="✕"
                Clicked="_deleteButton_Click"
                WidthRequest="40"
                Margin="2" />
    </Grid>
</ContentView>