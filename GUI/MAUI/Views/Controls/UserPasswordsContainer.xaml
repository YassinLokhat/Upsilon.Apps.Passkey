<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Upsilon.Apps.Passkey.GUI.MAUI.Views.Controls.UserPasswordsContainer">

    <Border StrokeShape="RoundRectangle 4"
            StrokeThickness="1"
            Stroke="{AppThemeBinding Light=#B0B0B0, Dark=#404040}"
            Padding="10"
            HeightRequest="220">

        <Grid RowDefinitions="Auto, *">
            <Label Grid.Row="0" 
                   Text="Passwords" 
                   FontAttributes="Bold" 
                   Margin="0,0,0,10" />

            <ScrollView Grid.Row="1" 
                        VerticalScrollBarVisibility="Default"
                        HorizontalScrollBarVisibility="Never">

                <Grid RowDefinitions="*, Auto">
                    <VerticalStackLayout Grid.Row="0" 
                                         x:Name="_stackLayout" 
                                         Spacing="5" />

                    <Button Grid.Row="1"
                            Text="+"
                            Clicked="_addButton_Click"
                            HorizontalOptions="Fill"
                            Margin="0,10,0,0" />
                </Grid>
            </ScrollView>
        </Grid>
    </Border>
</ContentView>