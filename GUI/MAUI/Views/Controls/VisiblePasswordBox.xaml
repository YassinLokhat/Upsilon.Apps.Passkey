<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Upsilon.Apps.Passkey.GUI.MAUI.Views.Controls.VisiblePasswordBox"
             x:Name="this">

    <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">

        <Entry x:Name="_passwordEntry"
               Grid.Column="0"
               Text="{Binding Password, Source={x:Reference this}, Mode=TwoWay}"
               IsPassword="{Binding IsPasswordHidden, Source={x:Reference this}}"
               IsReadOnly="{Binding ReadOnly, Source={x:Reference this}}"
               Background="{Binding BackgroundColor, Source={x:Reference this}}"
               TextChanged="_passwordEntry_TextChanged"
               Completed="_passwordEntry_Completed"/>

        <Button Grid.Column="1"
                Text="{Binding EyeIcon, Source={x:Reference this}}"
                FontFamily="Courier New"
                Clicked="EyeButton_Clicked"
                VerticalOptions="Center"
                Padding="10,0"/>
    </Grid>
</ContentView>