<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Upsilon.Apps.Passkey.GUI.Presentation.ViewModels;assembly=Upsilon.Apps.Passkey.GUI.Presentation"
             x:Class="Upsilon.Apps.Passkey.GUI.MAUI.SessionPage"
             x:ClassModifier="internal"
             x:DataType="viewmodels:SessionViewModel"
             Title="{Binding Username}">
   <Grid Padding="30,20" RowSpacing="12" RowDefinitions="Auto,*,Auto">

      <Label Grid.Row="0"
             Text="{Binding Summary}"
             Style="{StaticResource SubHeadline}" />

      <CollectionView Grid.Row="1"
                      ItemsSource="{Binding Services}">
         <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="viewmodels:ServiceSummary">
               <Grid Padding="0,6" ColumnDefinitions="*,Auto">
                  <Label Grid.Column="0" Text="{Binding ServiceName}" />
                  <Label Grid.Column="1" Text="{Binding AccountCount}" />
               </Grid>
            </DataTemplate>
         </CollectionView.ItemTemplate>
      </CollectionView>

      <Button Grid.Row="2"
              Text="Log out"
              Clicked="_onLogout" />
   </Grid>
</ContentPage>
