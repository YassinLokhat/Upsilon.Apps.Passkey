<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="BackgroundBrush" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="ForegroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="#2D2D30"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#3F3F46"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#007ACC"/>

    <SolidColorBrush x:Key="UnchangedBrush1" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="UnchangedBrush2" Color="#2D2D30"/>
    <SolidColorBrush x:Key="ChangedBrush" Color="#606060"/>

    <SolidColorBrush x:Key="InfoBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#52C16E"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#FFD84A"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#E04A4A"/>
    <SolidColorBrush x:Key="DisabledForegroundBrush" Color="#808080"/>
</ResourceDictionary>
