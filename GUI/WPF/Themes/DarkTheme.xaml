<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Strata palette (dark), taken from the Strata v2 design canvas. The vault
         window nests four layers, one per onion level: Layer0 (vault) is the
         darkest, Layer3 (password core) the lightest. Every key of the previous
         palette is kept. -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#08080A"/>
    <SolidColorBrush x:Key="ForegroundBrush" Color="#ECECF1"/>
    <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="#141419"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#2E2E36"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#6EE7C8"/>

    <!-- Field state: inputs are a translucent darkening of the surface they sit on. -->
    <SolidColorBrush x:Key="UnchangedBrush1" Color="#08080A"/>
    <SolidColorBrush x:Key="UnchangedBrush2" Color="#40000000"/>
    <SolidColorBrush x:Key="ChangedBrush" Color="#0D6EE7C8"/>

    <SolidColorBrush x:Key="InfoBrush" Color="#9A9AA6"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#5FD38A"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#F5B83D"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#FF6B6B"/>
    <SolidColorBrush x:Key="DisabledForegroundBrush" Color="#6E6E78"/>

    <!-- Strata additions -->
    <SolidColorBrush x:Key="MutedForegroundBrush" Color="#9A9AA6"/>
    <SolidColorBrush x:Key="FaintForegroundBrush" Color="#7C7C88"/>
    <SolidColorBrush x:Key="SoftForegroundBrush" Color="#C9C9D2"/>
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#34343E"/>
    <SolidColorBrush x:Key="SubtleBorderBrush" Color="#24242B"/>
    <SolidColorBrush x:Key="Divider1Brush" Color="#2A2A32"/>
    <SolidColorBrush x:Key="Divider2Brush" Color="#30303A"/>
    <SolidColorBrush x:Key="OutlineBrush" Color="#3A3A44"/>
    <SolidColorBrush x:Key="HoverBackgroundBrush" Color="#08FFFFFF"/>
    <SolidColorBrush x:Key="SelectedBackgroundBrush" Color="#0FFFFFFF"/>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#40000000"/>
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#08080A"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1F6EE7C8"/>
    <SolidColorBrush x:Key="EditedBorderBrush" Color="#806EE7C8"/>
    <SolidColorBrush x:Key="DangerTextBrush" Color="#FF8A8A"/>
    <SolidColorBrush x:Key="DangerBorderBrush" Color="#5A2A2E"/>
    <SolidColorBrush x:Key="DangerFieldBrush" Color="#4A2226"/>
    <SolidColorBrush x:Key="WarningFieldBrush" Color="#463613"/>
    <Color x:Key="CoreGlowColor">#6EE7C8</Color>

    <SolidColorBrush x:Key="Layer0Brush" Color="#0C0C0F"/>
    <SolidColorBrush x:Key="Layer1Brush" Color="#111115"/>
    <SolidColorBrush x:Key="Layer2Brush" Color="#17171C"/>
    <SolidColorBrush x:Key="Layer3Brush" Color="#1E1E25"/>

    <!-- Soft accent glow for things that "emit" the accent (selected rows,
         focused fields, mint buttons, dots, the logo). Small elements only;
         about half strength on the light theme, where glows read as smudges. -->
    <DropShadowEffect x:Key="Glow.Soft" ShadowDepth="0" BlurRadius="12" Opacity="0.28" Color="#6EE7C8"/>
    <DropShadowEffect x:Key="Glow.Warning" ShadowDepth="0" BlurRadius="10" Opacity="0.30" Color="#F5B83D"/>
    <DropShadowEffect x:Key="Glow.Pulse" ShadowDepth="0" BlurRadius="28" Opacity="0.55" Color="#6EE7C8"/>
    <sys:Double x:Key="CoreGlowOpacity">0.22</sys:Double>
</ResourceDictionary>
