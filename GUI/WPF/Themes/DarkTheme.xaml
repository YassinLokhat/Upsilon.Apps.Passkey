<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Strata palette (dark). The vault window nests four layers, one per
         onion level: Layer0 (vault) is the darkest, Layer3 (password core) the
         lightest. Every key of the previous palette is kept. -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#0A0A0D"/>
    <SolidColorBrush x:Key="ForegroundBrush" Color="#ECECF1"/>
    <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="#141419"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#2E2E36"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#6EE7C8"/>

    <SolidColorBrush x:Key="UnchangedBrush1" Color="#0A0A0D"/>
    <SolidColorBrush x:Key="UnchangedBrush2" Color="#141419"/>
    <SolidColorBrush x:Key="ChangedBrush" Color="#18392F"/>

    <SolidColorBrush x:Key="InfoBrush" Color="#B4B4BE"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#5FD38A"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#F5B83D"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#FF6B6B"/>
    <SolidColorBrush x:Key="DisabledForegroundBrush" Color="#6E6E78"/>

    <!-- Strata additions -->
    <SolidColorBrush x:Key="MutedForegroundBrush" Color="#9A9AA6"/>
    <SolidColorBrush x:Key="SubtleBorderBrush" Color="#24242B"/>
    <SolidColorBrush x:Key="HoverBackgroundBrush" Color="#1E1E25"/>
    <SolidColorBrush x:Key="SelectedBackgroundBrush" Color="#26262F"/>
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#08080A"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1F6EE7C8"/>
    <SolidColorBrush x:Key="DangerFieldBrush" Color="#4A2226"/>
    <SolidColorBrush x:Key="WarningFieldBrush" Color="#463613"/>

    <SolidColorBrush x:Key="Layer0Brush" Color="#0E0E12"/>
    <SolidColorBrush x:Key="Layer1Brush" Color="#131318"/>
    <SolidColorBrush x:Key="Layer2Brush" Color="#19191F"/>
    <SolidColorBrush x:Key="Layer3Brush" Color="#202028"/>
</ResourceDictionary>
