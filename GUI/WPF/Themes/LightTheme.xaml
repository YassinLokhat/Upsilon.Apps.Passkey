<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Strata palette (light). Layers go from a darker paper at Layer0 (vault)
         to plain white at Layer3 (password core). Every key of the previous
         palette is kept. -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#E6E6E0"/>
    <SolidColorBrush x:Key="ForegroundBrush" Color="#16161A"/>
    <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#C4C4BC"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#0F7B68"/>

    <SolidColorBrush x:Key="UnchangedBrush1" Color="#E6E6E0"/>
    <SolidColorBrush x:Key="UnchangedBrush2" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ChangedBrush" Color="#D3EEE6"/>

    <SolidColorBrush x:Key="InfoBrush" Color="#45454D"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#1B7A45"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#935500"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#BE2A2A"/>
    <SolidColorBrush x:Key="DisabledForegroundBrush" Color="#9A9AA2"/>

    <!-- Strata additions -->
    <SolidColorBrush x:Key="MutedForegroundBrush" Color="#5A5A64"/>
    <SolidColorBrush x:Key="SubtleBorderBrush" Color="#D6D6CF"/>
    <SolidColorBrush x:Key="HoverBackgroundBrush" Color="#E9E9E3"/>
    <SolidColorBrush x:Key="SelectedBackgroundBrush" Color="#DCDCD5"/>
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1F0F7B68"/>
    <SolidColorBrush x:Key="DangerFieldBrush" Color="#F7D9D9"/>
    <SolidColorBrush x:Key="WarningFieldBrush" Color="#F5E6C4"/>

    <SolidColorBrush x:Key="Layer0Brush" Color="#EDEDE8"/>
    <SolidColorBrush x:Key="Layer1Brush" Color="#F3F3EF"/>
    <SolidColorBrush x:Key="Layer2Brush" Color="#F9F9F6"/>
    <SolidColorBrush x:Key="Layer3Brush" Color="#FFFFFF"/>
</ResourceDictionary>
