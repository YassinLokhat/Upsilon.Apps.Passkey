<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Strata palette (light). Its own ramp: layers go from a darker paper at
         Layer0 (vault) to plain white at Layer3 (password core). Every key of
         the previous palette is kept. -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#E7E7E1"/>
    <SolidColorBrush x:Key="ForegroundBrush" Color="#16161A"/>
    <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#C6C6BE"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#0F7B68"/>

    <!-- Field state: inputs are a translucent darkening of the surface they sit on. -->
    <SolidColorBrush x:Key="UnchangedBrush1" Color="#E7E7E1"/>
    <SolidColorBrush x:Key="UnchangedBrush2" Color="#0C000000"/>
    <SolidColorBrush x:Key="ChangedBrush" Color="#140F7B68"/>

    <SolidColorBrush x:Key="InfoBrush" Color="#6E6E78"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#1B7A45"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#935500"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#BE2A2A"/>
    <SolidColorBrush x:Key="DisabledForegroundBrush" Color="#9A9AA2"/>

    <!-- Strata additions -->
    <SolidColorBrush x:Key="MutedForegroundBrush" Color="#5A5A64"/>
    <SolidColorBrush x:Key="FaintForegroundBrush" Color="#6E6E78"/>
    <SolidColorBrush x:Key="SoftForegroundBrush" Color="#33333B"/>
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#7A7A74"/>
    <SolidColorBrush x:Key="SubtleBorderBrush" Color="#D9D9D2"/>
    <SolidColorBrush x:Key="Divider1Brush" Color="#D4D4CD"/>
    <SolidColorBrush x:Key="Divider2Brush" Color="#CFCFC8"/>
    <SolidColorBrush x:Key="OutlineBrush" Color="#C2C2BA"/>
    <SolidColorBrush x:Key="HoverBackgroundBrush" Color="#0E000000"/>
    <SolidColorBrush x:Key="SelectedBackgroundBrush" Color="#15000000"/>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#0C000000"/>
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1F0F7B68"/>
    <SolidColorBrush x:Key="EditedBorderBrush" Color="#800F7B68"/>
    <SolidColorBrush x:Key="DangerTextBrush" Color="#B42318"/>
    <SolidColorBrush x:Key="DangerBorderBrush" Color="#E6B3AE"/>
    <SolidColorBrush x:Key="DangerFieldBrush" Color="#F7D9D9"/>
    <SolidColorBrush x:Key="WarningFieldBrush" Color="#F5E6C4"/>

    <!-- Dialogs and sections: a dialog sits one step off the main window, its
         sections one more step, and every control / section / window edge has a
         border of at least 3:1 against the surfaces on both sides of it (WCAG
         1.4.11), so nothing reads as black on black. -->
    <SolidColorBrush x:Key="DialogBackgroundBrush" Color="#F8F8F5"/>
    <SolidColorBrush x:Key="DialogTitleBarBrush" Color="#EEEEE9"/>
    <SolidColorBrush x:Key="SectionBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SectionBorderBrush" Color="#7A7A74"/>
    <SolidColorBrush x:Key="WindowEdgeBrush" Color="#7A7A74"/>
    <SolidColorBrush x:Key="Layer0Brush" Color="#EEEEE9"/>
    <SolidColorBrush x:Key="Layer1Brush" Color="#F3F3EF"/>
    <SolidColorBrush x:Key="Layer2Brush" Color="#F8F8F5"/>
    <SolidColorBrush x:Key="Layer3Brush" Color="#FFFFFF"/>

    <!-- Soft accent glow for things that "emit" the accent (selected rows,
         focused fields, mint buttons, dots, the logo). Small elements only;
         about half strength on the light theme, where glows read as smudges. -->
    <DropShadowEffect x:Key="Glow.Soft" ShadowDepth="0" BlurRadius="12" Opacity="0.12" Color="#0F7B68"/>
    <DropShadowEffect x:Key="Glow.Warning" ShadowDepth="0" BlurRadius="10" Opacity="0.12" Color="#935500"/>
    <sys:Double x:Key="CoreGlowOpacity">0.10</sys:Double>
</ResourceDictionary>
