<Window x:Class="Upsilon.Apps.Passkey.GUI.WPF.Views.AppSettingsView"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Upsilon.Apps.Passkey.GUI.WPF.Views"
        xmlns:viewmodels="clr-namespace:Upsilon.Apps.Passkey.GUI.WPF.ViewModels"
        xmlns:loc="clr-namespace:Upsilon.Apps.Passkey.GUI.WPF.Localization"
        d:DataContext="{d:DesignInstance Type=viewmodels:AppSettingsViewModel}"
        mc:Ignorable="d"
        Title="{Binding Title}"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Height="190" Width="550">
   <Grid>
      <Grid.RowDefinitions>
         <RowDefinition Height="Auto"/>
         <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Menu Grid.Row="0">
         <MenuItem Header="{loc:Loc Menu_Save}"
                      Click="_saveMenuItem_Click"/>
         <MenuItem Header="{loc:Loc Menu_ResetToDefault}"
                      Click="_resetMenuItem_Click"/>
      </Menu>
      <StackPanel Grid.Row="1">
         <Grid Margin="0,4">
            <Grid.ColumnDefinitions>
               <ColumnDefinition Width="Auto"/>
               <ColumnDefinition Width="*"/>
               <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Label Grid.Column="0" Margin="0" Content="{loc:Loc Label_DefaultDatabaseDirectory}"/>
            <TextBox Grid.Column="1"
                     IsReadOnly="True"
                     Text="{Binding DefaultDatabaseDirectory}"/>
            <Button Grid.Column="2"
                    Content="{loc:Loc Label_Browse}"
                    Click="_browseButton_Click"/>
         </Grid>
         <Grid Margin="0,4">
            <Grid.ColumnDefinitions>
               <ColumnDefinition Width="Auto"/>
               <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0" Margin="0" Content="{loc:Loc Label_Language}"/>
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding Languages}"
                      SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                      DisplayMemberPath="NativeName"/>
         </Grid>
         <Grid Margin="0,4">
            <Grid.ColumnDefinitions>
               <ColumnDefinition Width="Auto"/>
               <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0" Margin="0" Content="{loc:Loc Label_Theme}"/>
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding Themes}"
                      SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                      DisplayMemberPath="DisplayName"/>
         </Grid>
      </StackPanel>
   </Grid>
</Window>
