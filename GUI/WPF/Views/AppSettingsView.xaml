<Window x:Class="Upsilon.Apps.Passkey.GUI.WPF.Views.AppSettingsView"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Upsilon.Apps.Passkey.GUI.WPF.Views"
        xmlns:viewmodels="clr-namespace:Upsilon.Apps.Passkey.GUI.WPF.ViewModels"
        xmlns:loc="clr-namespace:Upsilon.Apps.Passkey.GUI.WPF.Localization"
        d:DataContext="{d:DesignInstance Type=viewmodels:AppSettingsViewModel}"
        mc:Ignorable="d"
        Title="{Binding Title}"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Height="360" Width="620">
   <Grid>
      <Grid.RowDefinitions>
         <RowDefinition Height="Auto"/>
         <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Menu Grid.Row="0">
         <MenuItem Header="{loc:Loc Menu_Save}"
                      Click="_saveMenuItem_Click"/>
         <MenuItem Header="{loc:Loc Menu_ResetToDefault}"
                      Click="_resetMenuItem_Click"/>
      </Menu>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel>
         <Grid Margin="0,4">
            <Grid.ColumnDefinitions>
               <ColumnDefinition Width="Auto"/>
               <ColumnDefinition Width="*"/>
               <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Label Grid.Column="0" Margin="0" Content="{loc:Loc Label_DefaultDatabaseDirectory}"/>
            <TextBox Grid.Column="1"
                     IsReadOnly="True"
                     Text="{Binding DefaultDatabaseDirectory}"/>
            <Button Grid.Column="2"
                    Content="{loc:Loc Label_Browse}"
                    Click="_browseButton_Click"/>
         </Grid>
         <Grid Margin="0,4">
            <Grid.ColumnDefinitions>
               <ColumnDefinition Width="Auto"/>
               <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0" Margin="0" Content="{loc:Loc Label_Language}"/>
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding Languages}"
                      SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                      DisplayMemberPath="NativeName"/>
         </Grid>
         <Grid Margin="0,4">
            <Grid.ColumnDefinitions>
               <ColumnDefinition Width="Auto"/>
               <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0" Margin="0" Content="{loc:Loc Label_Theme}"/>
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding Themes}"
                      SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                      DisplayMemberPath="DisplayName"/>
         </Grid>
         <GroupBox Header="Offline leak database"
                   Margin="0,8,0,4"
                   ToolTip="Application-wide setting shared by all vault users. Not stored in the .pku vault. Disable keeps the file; only Delete removes it.">
            <StackPanel Margin="4">
               <TextBlock TextWrapping="Wrap" Margin="0,0,0,6"
                          Text="{Binding OfflineLeakFilterStatus}"/>
               <CheckBox Content="Use offline Bloom filter when HIBP and XposedOrNot are unreachable"
                         IsChecked="{Binding OfflineLeakFilterEnabled}"
                         IsEnabled="{Binding OfflineLeakFilterIdle}"
                         Checked="_offlineLeakFilterEnabled_Changed"
                         Unchecked="_offlineLeakFilterEnabled_Changed"/>
               <TextBlock TextWrapping="Wrap" Margin="0,4,0,4" Foreground="Gray"
                          Text="{Binding OfflineLeakFilterProgress}"/>
               <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                  <Button Content="Build / Update"
                          Margin="0,0,8,0"
                          Padding="8,2"
                          IsEnabled="{Binding OfflineLeakFilterIdle}"
                          Click="_offlineLeakFilterBuild_Click"/>
                  <Button Content="Delete offline database"
                          Padding="8,2"
                          IsEnabled="{Binding OfflineLeakFilterIdle}"
                          Click="_offlineLeakFilterDelete_Click"/>
               </StackPanel>
            </StackPanel>
         </GroupBox>
      </StackPanel>
      </ScrollViewer>
   </Grid>
</Window>
