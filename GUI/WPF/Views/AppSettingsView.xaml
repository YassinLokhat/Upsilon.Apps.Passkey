<Window x:Class="Upsilon.Apps.Passkey.GUI.WPF.Views.AppSettingsView"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Upsilon.Apps.Passkey.GUI.WPF.Views"
        xmlns:viewmodels="clr-namespace:Upsilon.Apps.Passkey.GUI.WPF.ViewModels"
        xmlns:loc="clr-namespace:Upsilon.Apps.Passkey.GUI.WPF.Localization"
        d:DataContext="{d:DesignInstance Type=viewmodels:AppSettingsViewModel}"
        mc:Ignorable="d"
        Title="{Binding Title}"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Height="255" Width="700">
   <Grid>
      <Grid.RowDefinitions>
         <RowDefinition Height="Auto"/>
         <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Menu Grid.Row="0"
            IsEnabled="{Binding OfflineLeakFilterIdle}">
         <MenuItem Header="{loc:Loc Menu_Save}"
                   Click="_saveMenuItem_Click"/>
         <MenuItem Header="{loc:Loc Menu_ResetToDefault}"
                   Click="_resetMenuItem_Click"/>
      </Menu>
      <ScrollViewer Grid.Row="1"
                    VerticalScrollBarVisibility="Auto">
         <StackPanel>
            <Grid>
               <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
               </Grid.ColumnDefinitions>

               <Label Grid.Column="0"
                      Content="{loc:Loc Label_DefaultDatabaseDirectory}"/>
               <TextBox Grid.Column="1"
                        IsReadOnly="True"
                        Text="{Binding DefaultDatabaseDirectory}"/>
               <Button Grid.Column="2"
                       Content="{loc:Loc Label_Browse}"
                       IsEnabled="{Binding OfflineLeakFilterIdle}"
                       Click="_browseButton_Click"/>
            </Grid>
            <Grid>
               <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
               </Grid.ColumnDefinitions>
               <Label Grid.Column="0"
                      Content="{loc:Loc Label_Language}"/>
               <ComboBox Grid.Column="1"
                         ItemsSource="{Binding Languages}"
                         SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                         DisplayMemberPath="NativeName"
                         IsEnabled="{Binding OfflineLeakFilterIdle}"/>
               <Label Grid.Column="2"
                      Content="{loc:Loc Label_Theme}"/>
               <ComboBox Grid.Column="3"
                         ItemsSource="{Binding Themes}"
                         SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                         DisplayMemberPath="DisplayName"
                         IsEnabled="{Binding OfflineLeakFilterIdle}"/>
            </Grid>
            <GroupBox Header="{loc:Loc Label_OfflineLeakDatabase}"
                      ToolTip="{loc:Loc Tooltip_OfflineLeakDatabase}">
               <StackPanel>
                  <Grid>
                     <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                     </Grid.ColumnDefinitions>

                     <TextBlock Grid.Column="0"
                                TextWrapping="Wrap"
                                Text="{Binding OfflineLeakFilterStatus}"/>
                     <TextBlock Grid.Column="1"
                                TextWrapping="Wrap"
                                Foreground="Gray"
                                Text="{Binding OfflineLeakFilterProgress}"/>
                  </Grid>
                  <CheckBox Content="{loc:Loc Label_UseOfflineBloomFilter}"
                            IsChecked="{Binding OfflineLeakFilterEnabled}"
                            IsEnabled="{Binding OfflineLeakFilterIdle}"
                            Checked="_offlineLeakFilterEnabled_Changed"
                            Unchecked="_offlineLeakFilterEnabled_Changed"/>
                  <Grid>
                     <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                     </Grid.ColumnDefinitions>

                     <Button Grid.Column="0"
                             Content="{Binding OfflineLeakFilterBuildButtonText}"
                             Click="_offlineLeakFilterBuild_Click"/>
                     <Button Grid.Column="1"
                             Content="{loc:Loc Label_DeleteOfflineDatabase}"
                             IsEnabled="{Binding OfflineLeakFilterIdle}"
                             Click="_offlineLeakFilterDelete_Click"/>
                  </Grid>
               </StackPanel>
            </GroupBox>
         </StackPanel>
      </ScrollViewer>
   </Grid>
</Window>
