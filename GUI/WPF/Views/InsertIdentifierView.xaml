<Window x:Class="Upsilon.Apps.Passkey.GUI.WPF.Views.InsertIdentifierView"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Upsilon.Apps.Passkey.GUI.WPF.Views"
        xmlns:viewmodels="clr-namespace:Upsilon.Apps.Passkey.GUI.WPF.ViewModels"
        xmlns:loc="clr-namespace:Upsilon.Apps.Passkey.GUI.WPF.Localization"
        d:DataContext="{d:DesignInstance Type=viewmodels:InsertIdentifierViewModel}"
        mc:Ignorable="d"
        Title="{loc:Loc Title_InsertIdentifier}"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Height="300" Width="270">
   <Grid>
      <Grid.RowDefinitions>
         <RowDefinition Height="Auto"/>
         <RowDefinition Height="Auto"/>
         <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <StackPanel Grid.Row="0"
                  Orientation="Horizontal">
         <TextBox Name="_identifier_TB"
                  Width="200"
                  Text="{Binding Identifier, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  KeyUp="_identifier_TextBox_KeyUp"/>
         <Button Content="✕"
                 ToolTip="{loc:Loc Tooltip_Clear}"
                 Click="_clearFilter_Button_Click"/>
      </StackPanel>
      <StackPanel Grid.Row="1"
            Name="_identifierTypes_SP">
         <RadioButton Content="{loc:Loc IdentifierType_Username}"
                 Tag="Username"
                 Checked="_insertIdentifierType_RadioButton_Checked"/>
         <RadioButton Content="{loc:Loc IdentifierType_Email}"
                 Tag="Email"
                 Checked="_insertIdentifierType_RadioButton_Checked"/>
         <RadioButton Content="{loc:Loc IdentifierType_Passkey}"
                 Tag="Passkey"
                 Checked="_insertIdentifierType_RadioButton_Checked"/>
         <RadioButton Content="{loc:Loc IdentifierType_PhoneNumber}"
                 Tag="PhoneNumber"
                 Checked="_insertIdentifierType_RadioButton_Checked"/>
         <RadioButton Content="{loc:Loc IdentifierType_AuthenticatorApp}"
                 Tag="AuthenticatorApp"
                 Checked="_insertIdentifierType_RadioButton_Checked"/>
      </StackPanel>
      <ListBox Name="_identifiers_LB"
               Grid.Row="2"
               SelectionChanged="_identifiers_LB_SelectionChanged"/>
   </Grid>
</Window>
