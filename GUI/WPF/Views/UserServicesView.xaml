<Window xmlns:Controls="clr-namespace:Upsilon.Apps.Passkey.GUI.WPF.Views.Controls"
        x:Class="Upsilon.Apps.Passkey.GUI.WPF.Views.UserServicesView"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Upsilon.Apps.Passkey.GUI.WPF.Views"
        xmlns:viewmodels="clr-namespace:Upsilon.Apps.Passkey.GUI.WPF.ViewModels"
        xmlns:loc="clr-namespace:Upsilon.Apps.Passkey.GUI.WPF.Localization"
        d:DataContext="{d:DesignInstance Type=viewmodels:UserServicesViewModel}"
        mc:Ignorable="d"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Closed="_window_Closed"
        Title="{Binding Title}"
        Height="700"
        Width="1300"
        MinHeight="700"
        MinWidth="1300">
   <Window.InputBindings>
      <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}"/>
      <KeyBinding Key="OemComma" Modifiers="Control+Shift" Command="{Binding UserSettingsCommand}"/>
      <KeyBinding Key="P" Modifiers="Control" Command="{Binding GeneratePasswordCommand}"/>
      <KeyBinding Key="A" Modifiers="Control+Shift" Command="{Binding ShowActivitiesCommand}"/>
      <KeyBinding Key="OemComma" Modifiers="Control" Command="{Binding AppSettingsCommand}"/>
      <KeyBinding Key="L" Modifiers="Control+Shift" Command="{Binding CopyIdentifierCommand}"/>
      <KeyBinding Key="P" Modifiers="Control+Shift" Command="{Binding CopyPasswordCommand}"/>
      <KeyBinding Key="F" Modifiers="Control" Command="{Binding FocusFilterCommand}"/>
      <KeyBinding Key="F3" Command="{Binding FocusFilterCommand}"/>
      <KeyBinding Key="F" Modifiers="Control+Shift" Command="{Binding ClearFiltersCommand}"/>
      <KeyBinding Key="F3" Modifiers="Shift" Command="{Binding ClearFiltersCommand}"/>
   </Window.InputBindings>
   <Grid>
      <Grid.RowDefinitions>
         <RowDefinition Height="Auto"/>
         <RowDefinition Height="Auto"/>
         <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Menu Grid.Row="0">
         <Menu.ItemsPanel>
            <ItemsPanelTemplate>
               <DockPanel HorizontalAlignment="Stretch"/>
            </ItemsPanelTemplate>
         </Menu.ItemsPanel>
         <MenuItem Header="{loc:Loc Menu_Save}"
                   DockPanel.Dock="Left"
                   Command="{Binding SaveCommand}"
                   InputGestureText="Ctrl+S"/>
         <MenuItem Header="{loc:Loc Menu_UserSettings}"
                   DockPanel.Dock="Left"
                   Command="{Binding UserSettingsCommand}"
                   InputGestureText="Ctrl+Shift+,"/>
         <MenuItem Header="{loc:Loc Menu_GenerateRandomPassword}"
                   DockPanel.Dock="Left"
                   Command="{Binding GeneratePasswordCommand}"
                   InputGestureText="Ctrl+P"/>
         <MenuItem Header="{loc:Loc Menu_ShowActivities}"
                   DockPanel.Dock="Left"
                   Command="{Binding ShowActivitiesCommand}"
                   InputGestureText="Ctrl+Shift+A"/>
         <MenuItem Name="_alerts_MI"
                   Header="{Binding ShowAlerts}"
                   DockPanel.Dock="Left"
                   Foreground="{Binding ShowAlertsColor}">
            <MenuItem Name="_activityAlerts_MI"
                      Header="{Binding ShowActivityAlerts}"
                      Foreground="{Binding ShowActivityAlertsColor}"
                      Command="{Binding ShowActivityAlertsCommand}"/>
            <MenuItem Name="_duplicatedPasswordAlerts_MI"
                      Header="{Binding ShowDuplicatedPasswordAlerts}"
                      Foreground="{Binding ShowDuplicatedPasswordAlertsColor}"
                      Command="{Binding ShowDuplicatedPasswordAlertsCommand}"/>
            <MenuItem Name="_expiredPasswordAlerts_MI"
                      Header="{Binding ShowExpiredPasswordAlerts}"
                      Foreground="{Binding ShowExpiredPasswordAlertsColor}"
                      Command="{Binding ShowExpiredPasswordAlertsCommand}"/>
            <MenuItem Name="_leakedPasswordAlerts_MI"
                      Header="{Binding ShowLeakedPasswordAlerts}"
                      Foreground="{Binding ShowLeakedPasswordAlertsColor}"
                      Command="{Binding ShowLeakedPasswordAlertsCommand}"/>
            <MenuItem Name="_securitySettingsAlerts_MI"
                      Header="{Binding ShowSecuritySettingsAlerts}"
                      Foreground="{Binding ShowSecuritySettingsAlertsColor}"
                      Command="{Binding ShowSecuritySettingsAlertsCommand}"/>
            <MenuItem Name="_passkeyQualityAlerts_MI"
                      Header="{Binding ShowPasskeyQualityAlerts}"
                      Foreground="{Binding ShowPasskeyQualityAlertsColor}"
                      Command="{Binding ShowPasskeyQualityAlertsCommand}"/>
         </MenuItem>
         <MenuItem Header="{loc:Loc Menu_Logout}"
                   HorizontalAlignment="Right"
                   DockPanel.Dock="Right"
                   Command="{Binding LogoutCommand}"/>
         <MenuItem Header="{loc:Loc Menu_AppSettings}"
                   HorizontalAlignment="Right"
                   DockPanel.Dock="Right"
                   Command="{Binding AppSettingsCommand}"
                   InputGestureText="Ctrl+,"/>
      </Menu>
      <GroupBox Grid.Row="1"
                Header="{loc:Loc Label_Filters}">
         <Grid>
            <Grid.ColumnDefinitions>
               <ColumnDefinition Width="Auto"/>
               <ColumnDefinition Width="*"/>
               <ColumnDefinition Width="Auto"/>
               <ColumnDefinition Width="*"/>
               <ColumnDefinition Width="Auto"/>
               <ColumnDefinition Width="*"/>
               <ColumnDefinition Width="Auto"/>
               <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Label Grid.Column="0"
                   Content="{loc:Loc Label_Service}"/>
            <TextBox Name="_serviceFilter_TB"
                     Grid.Column="1"
                     Text="{Binding ServiceFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <Label Grid.Column="2"
                   Content="{loc:Loc Label_Identifier}"/>
            <TextBox Grid.Column="3"
                     Text="{Binding IdentifierFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <Label Grid.Column="4"
                   Content="{loc:Loc Label_Text}"/>
            <TextBox Grid.Column="5"
                     Text="{Binding TextFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <CheckBox Grid.Column="6"
                      Content="{loc:Loc Label_UnsavedItemsOnly}"
                      IsChecked="{Binding ChangedItemsOnly, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <Button Grid.Column="7"
                    Content="✕"
                    ToolTip="{loc:Loc Tooltip_ClearFilters}"
                    Command="{Binding ClearFiltersCommand}"/>
         </Grid>
      </GroupBox>
      <GroupBox Grid.Row="2"
                Name="_userServices_GB"
                Header="{Binding UserId}"
                MouseRightButtonUp="_userServicesView_MouseRightButtonUp">
         <Grid>
            <Grid.RowDefinitions>
               <RowDefinition Height="*"/>
               <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
               <ColumnDefinition Width="Auto"/>
               <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ListBox Grid.Row="0"
                     Grid.Column="0"
                     Name="_services_LB"
                     ItemsSource="{Binding Services}"
                     SelectedItem="{Binding SelectedService, Mode=TwoWay}"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.CanContentScroll="True"
                     ScrollViewer.IsDeferredScrollingEnabled="True"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                     SelectionChanged="_services_LB_SelectionChanged">
               <ListBox.ItemTemplate>
                  <DataTemplate>
                     <Label Margin="0"
                            Content="{Binding ServiceDisplay}"
                            Background="Transparent"/>
                  </DataTemplate>
               </ListBox.ItemTemplate>
            </ListBox>
            <Grid Grid.Row="1"
                  Grid.Column="0">
               <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
               </Grid.ColumnDefinitions>
               <Button Grid.Column="0"
                       Command="{Binding AddServiceCommand}"
                       ToolTip="{loc:Loc Tooltip_AddService}"
                       Content="+"/>
               <Button Grid.Column="1"
                       Command="{Binding DeleteServiceCommand}"
                       ToolTip="{loc:Loc Tooltip_DeleteService}"
                       Content="✕"/>
            </Grid>
            <Controls:ServiceView x:Name="_service_SV"
                                  Grid.Row="0"
                                  Grid.RowSpan="2"
                                  Grid.Column="1"/>
         </Grid>
      </GroupBox>
   </Grid>
</Window>
