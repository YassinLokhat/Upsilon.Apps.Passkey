<Window xmlns:Controls="clr-namespace:Upsilon.Apps.Passkey.GUI.WPF.Views.Controls"
        x:Class="Upsilon.Apps.Passkey.GUI.WPF.Views.UserServicesView"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Upsilon.Apps.Passkey.GUI.WPF.Views"
        xmlns:viewmodels="clr-namespace:Upsilon.Apps.Passkey.GUI.WPF.ViewModels"
        xmlns:loc="clr-namespace:Upsilon.Apps.Passkey.GUI.WPF.Localization"
        d:DataContext="{d:DesignInstance Type=viewmodels:UserServicesViewModel}"
        mc:Ignorable="d"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Closed="_window_Closed"
        Title="{Binding Title}"
        Height="700"
        Width="1300"
        MinHeight="700"
        MinWidth="1300">
   <Window.CommandBindings>
      <CommandBinding Command="Save" Executed="_save_MenuItem_Click"/>
      <CommandBinding Command="Print" Executed="_generateRandomPassword_MenuItem_Click"/>
      <CommandBinding Command="Find" Executed="_filterCommand_CommandBinding_Executed"/>
      <CommandBinding Command="Stop" Executed="_filterClear_Button_Click"/>
   </Window.CommandBindings>
   <Window.InputBindings>
      <KeyBinding Key="S" Modifiers="Control" Command="Save"/>
      <KeyBinding Key="P" Modifiers="Control" Command="Print"/>
      <KeyBinding Key="F" Modifiers="Control" Command="Find"/>
      <KeyBinding Key="F3" Command="Find"/>
      <KeyBinding Key="F" Modifiers="Control+Shift" Command="Stop"/>
      <KeyBinding Key="F3" Modifiers="Shift" Command="Stop"/>
   </Window.InputBindings>
   <Grid>
      <Grid.RowDefinitions>
         <RowDefinition Height="Auto"/>
         <RowDefinition Height="Auto"/>
         <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Menu Grid.Row="0">
         <Menu.ItemsPanel>
            <ItemsPanelTemplate>
               <DockPanel HorizontalAlignment="Stretch"/>
            </ItemsPanelTemplate>
         </Menu.ItemsPanel>
         <MenuItem Header="{loc:Loc Menu_Save}"
                   DockPanel.Dock="Left"
                   Command="Save"/>
         <MenuItem Header="{loc:Loc Menu_UserSettings}"
                   DockPanel.Dock="Left"
                   Click="_userSettings_MenuItem_Click"/>
         <MenuItem Header="{loc:Loc Menu_GenerateRandomPassword}"
                   DockPanel.Dock="Left"
                   Command="Print"/>
         <MenuItem Header="{loc:Loc Menu_ShowActivities}"
                   DockPanel.Dock="Left"
                   Click="_showActivities_MenuItem_Click"/>
         <MenuItem Name="_warnings_MI"
                   Header="{Binding ShowWarnings}"
                   DockPanel.Dock="Left"
                   Foreground="{Binding ShowWarningsColor}">
            <MenuItem Name="_activityWarnings_MI"
                      Header="{Binding ShowActivityWarnings}"
                      Foreground="{Binding ShowActivityWarningsColor}"
                      Click="_activityWarnings_MI_Click"/>
            <MenuItem Name="_duplicatedPasswordWarnings_MI"
                      Header="{Binding ShowDuplicatedPasswordWarnings}"
                      Foreground="{DynamicResource WarningBrush}"
                      Click="_duplicatedPasswordWarnings_MI_Click"/>
            <MenuItem Name="_expiredPasswordWarnings_MI"
                      Header="{Binding ShowExpiredPasswordWarnings}"
                      Foreground="{DynamicResource DangerBrush}"
                      Click="_expiredOrLeakedPasswordWarnings_MI_Click"/>
            <MenuItem Name="_leakedPasswordWarnings_MI"
                      Header="{Binding ShowLeakedPasswordWarnings}"
                      Foreground="{DynamicResource DangerBrush}"
                      Click="_expiredOrLeakedPasswordWarnings_MI_Click"/>
            <MenuItem Name="_securitySettingsWarnings_MI"
                      Header="{Binding ShowSecuritySettingsWarnings}"
                      Foreground="{DynamicResource WarningBrush}"
                      Click="_securitySettingsWarnings_MI_Click"/>
         </MenuItem>
         <MenuItem Header="{loc:Loc Menu_Logout}"
                   HorizontalAlignment="Right"
                   DockPanel.Dock="Right"
                   Click="_logout_MenuItem_Click"/>
      </Menu>
      <GroupBox Grid.Row="1"
                Header="{loc:Loc Label_Filters}">
         <Grid>
            <Grid.ColumnDefinitions>
               <ColumnDefinition Width="Auto"/>
               <ColumnDefinition Width="*"/>
               <ColumnDefinition Width="Auto"/>
               <ColumnDefinition Width="*"/>
               <ColumnDefinition Width="Auto"/>
               <ColumnDefinition Width="*"/>
               <ColumnDefinition Width="Auto"/>
               <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Label Grid.Column="0"
                   Content="{loc:Loc Label_Service}"/>
            <TextBox Name="_serviceFilter_TB"
                     Grid.Column="1"
                     Text="{Binding ServiceFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <Label Grid.Column="2"
                   Content="{loc:Loc Label_Identifier}"/>
            <TextBox Grid.Column="3"
                     Text="{Binding IdentifierFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <Label Grid.Column="4"
                   Content="{loc:Loc Label_Text}"/>
            <TextBox Grid.Column="5"
                     Text="{Binding TextFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <CheckBox Grid.Column="6"
                      Content="{loc:Loc Label_UnsavedItemsOnly}"
                      IsChecked="{Binding ChangedItemsOnly, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <Button Grid.Column="7"
                    Content="✕"
                    ToolTip="{loc:Loc Tooltip_ClearFilters}"
                    Command="{Binding ClearFiltersCommand}"/>
         </Grid>
      </GroupBox>
      <GroupBox Grid.Row="2"
                Name="_userServices_GB"
                Header="{Binding UserId}"
                MouseRightButtonUp="_userServicesView_MouseRightButtonUp">
         <Grid>
            <Grid.RowDefinitions>
               <RowDefinition Height="*"/>
               <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
               <ColumnDefinition Width="Auto"/>
               <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ListBox Grid.Row="0"
                     Grid.Column="0"
                     Name="_services_LB"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.CanContentScroll="True"
                     ScrollViewer.IsDeferredScrollingEnabled="True"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                     SelectionChanged="_services_LB_SelectionChanged">
               <ListBox.ItemTemplate>
                  <DataTemplate>
                     <Label Margin="0"
                            Content="{Binding ServiceDisplay}"
                            Background="Transparent"/>
                  </DataTemplate>
               </ListBox.ItemTemplate>
            </ListBox>
            <Grid Grid.Row="1"
                  Grid.Column="0">
               <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
               </Grid.ColumnDefinitions>
               <Button Grid.Column="0"
                       Click="_addService_Button_Click"
                       ToolTip="{loc:Loc Tooltip_AddService}"
                       Content="+"/>
               <Button Grid.Column="1"
                       Click="_deleteService_Button_Click"
                       ToolTip="{loc:Loc Tooltip_DeleteService}"
                       Content="✕"/>
            </Grid>
            <Controls:ServiceView x:Name="_service_SV"
                                  Grid.Row="0"
                                  Grid.RowSpan="2"
                                  Grid.Column="1"/>
         </Grid>
      </GroupBox>
   </Grid>
</Window>
