<Window xmlns:Controls="clr-namespace:Upsilon.Apps.Passkey.GUI.WPF.Views.Controls"
        x:Class="Upsilon.Apps.Passkey.GUI.WPF.Views.UserServicesView"
        Style="{StaticResource StrataWindow}"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Upsilon.Apps.Passkey.GUI.WPF.Views"
        xmlns:viewmodels="clr-namespace:Upsilon.Apps.Passkey.GUI.WPF.ViewModels"
        xmlns:loc="clr-namespace:Upsilon.Apps.Passkey.GUI.WPF.Localization"
        xmlns:helper="clr-namespace:Upsilon.Apps.Passkey.GUI.WPF.Helper"
        d:DataContext="{d:DesignInstance Type=viewmodels:UserServicesViewModel}"
        mc:Ignorable="d"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Closed="_window_Closed"
        Title="{Binding Title}"
        Height="700"
        Width="1300"
        MinHeight="700"
        MinWidth="1300">
   <Window.InputBindings>
      <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}"/>
      <KeyBinding Key="Z" Modifiers="Control+Shift" Command="{Binding UndoCommand}"/>
      <KeyBinding Key="Y" Modifiers="Control+Shift" Command="{Binding RedoCommand}"/>
      <KeyBinding Key="OemComma" Modifiers="Control+Shift" Command="{Binding UserSettingsCommand}"/>
      <KeyBinding Key="P" Modifiers="Control" Command="{Binding GeneratePasswordCommand}"/>
      <KeyBinding Key="A" Modifiers="Control+Shift" Command="{Binding ShowActivitiesCommand}"/>
      <KeyBinding Key="OemComma" Modifiers="Control" Command="{Binding AppSettingsCommand}"/>
      <KeyBinding Key="L" Modifiers="Control+Shift" Command="{Binding CopyIdentifierCommand}"/>
      <KeyBinding Key="P" Modifiers="Control+Shift" Command="{Binding CopyPasswordCommand}"/>
      <KeyBinding Key="F" Modifiers="Control" Command="{Binding FocusFilterCommand}"/>
      <KeyBinding Key="F3" Command="{Binding FocusFilterCommand}"/>
      <KeyBinding Key="F" Modifiers="Control+Shift" Command="{Binding ClearFiltersCommand}"/>
      <KeyBinding Key="F3" Modifiers="Shift" Command="{Binding ClearFiltersCommand}"/>
   </Window.InputBindings>
   <Grid>
      <Grid.RowDefinitions>
         <RowDefinition Height="Auto"/>
         <RowDefinition Height="*"/>
         <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Border Grid.Row="0"
              BorderBrush="{DynamicResource SubtleBorderBrush}"
              BorderThickness="0,0,0,1">
         <Menu helper:StrataChrome.ShortcutChipsMinWidth="1600">
            <Menu.Resources>
               <!-- Vertical divider between command groups, as in the design. -->
               <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
                  <Setter Property="Template">
                     <Setter.Value>
                        <ControlTemplate TargetType="Separator">
                           <Border Width="1"
                                   Height="18"
                                   Margin="6,0"
                                   Background="{DynamicResource BorderBrush}"/>
                        </ControlTemplate>
                     </Setter.Value>
                  </Setter>
               </Style>
            </Menu.Resources>
            <Menu.ItemsPanel>
               <ItemsPanelTemplate>
                  <DockPanel HorizontalAlignment="Stretch"/>
               </ItemsPanelTemplate>
            </Menu.ItemsPanel>
            <MenuItem Header="{loc:Loc Menu_Save}"
                      DockPanel.Dock="Left"
                      Command="{Binding SaveCommand}"
                      InputGestureText="Ctrl+S"/>
            <MenuItem Header="{loc:Loc Menu_Undo}"
                      DockPanel.Dock="Left"
                      Command="{Binding UndoCommand}"
                      InputGestureText="Ctrl+Shift+Z"/>
            <MenuItem Header="{loc:Loc Menu_Redo}"
                      DockPanel.Dock="Left"
                      Command="{Binding RedoCommand}"
                      InputGestureText="Ctrl+Shift+Y"/>
            <Separator DockPanel.Dock="Left"/>
            <MenuItem Header="{loc:Loc Menu_GenerateRandomPassword}"
                      DockPanel.Dock="Left"
                      Command="{Binding GeneratePasswordCommand}"
                      InputGestureText="Ctrl+P"/>
            <MenuItem Header="{loc:Loc Menu_ShowActivities}"
                      DockPanel.Dock="Left"
                      Command="{Binding ShowActivitiesCommand}"
                      InputGestureText="Ctrl+Shift+A"/>
            <MenuItem Header="{loc:Loc Menu_Logout}"
                      HorizontalAlignment="Right"
                      DockPanel.Dock="Right"
                      Command="{Binding LogoutCommand}"/>
            <MenuItem Header="{loc:Loc Menu_AppSettings}"
                      HorizontalAlignment="Right"
                      DockPanel.Dock="Right"
                      Command="{Binding AppSettingsCommand}"
                      InputGestureText="Ctrl+,"/>
            <MenuItem Header="{loc:Loc Menu_UserSettings}"
                      DockPanel.Dock="Right"
                      Command="{Binding UserSettingsCommand}"
                      InputGestureText="Ctrl+Shift+,"/>
            <Separator DockPanel.Dock="Right"/>
            <MenuItem Name="_alerts_MI"
                      HorizontalAlignment="Right"
                      Header="{Binding ShowAlerts}"
                      DockPanel.Dock="Right"
                      Foreground="{Binding ShowAlertsColor}">
               <MenuItem Name="_activityAlerts_MI"
                         Header="{Binding ShowActivityAlerts}"
                         Foreground="{Binding ShowActivityAlertsColor}"
                         Command="{Binding ShowActivityAlertsCommand}"/>
               <MenuItem Name="_duplicatedPasswordAlerts_MI"
                         Header="{Binding ShowDuplicatedPasswordAlerts}"
                         Foreground="{Binding ShowDuplicatedPasswordAlertsColor}"
                         Command="{Binding ShowDuplicatedPasswordAlertsCommand}"/>
               <MenuItem Name="_expiredPasswordAlerts_MI"
                         Header="{Binding ShowExpiredPasswordAlerts}"
                         Foreground="{Binding ShowExpiredPasswordAlertsColor}"
                         Command="{Binding ShowExpiredPasswordAlertsCommand}"/>
               <MenuItem Name="_leakedPasswordAlerts_MI"
                         Header="{Binding ShowLeakedPasswordAlerts}"
                         Foreground="{Binding ShowLeakedPasswordAlertsColor}"
                         Command="{Binding ShowLeakedPasswordAlertsCommand}"/>
               <MenuItem Name="_weakPasswordAlerts_MI"
                         Header="{Binding ShowWeakPasswordAlerts}"
                         Foreground="{Binding ShowWeakPasswordAlertsColor}"
                         Command="{Binding ShowWeakPasswordAlertsCommand}"/>
               <MenuItem Name="_securitySettingsAlerts_MI"
                         Header="{Binding ShowSecuritySettingsAlerts}"
                         Foreground="{Binding ShowSecuritySettingsAlertsColor}"
                         Command="{Binding ShowSecuritySettingsAlertsCommand}"/>
               <MenuItem Name="_passkeyQualityAlerts_MI"
                         Header="{Binding ShowPasskeyQualityAlerts}"
                         Foreground="{Binding ShowPasskeyQualityAlertsColor}"
                         Command="{Binding ShowPasskeyQualityAlertsCommand}"/>
            </MenuItem>
         </Menu>
      </Border>

      <!-- Layer 0: the vault. Filters on top, services on the left, the
           service layer nested on the right. -->
      <GroupBox Grid.Row="1"
                Margin="12"
                Style="{StaticResource LayerGroupBox}"
                Background="{DynamicResource Layer0Brush}">
         <GroupBox.Header>
            <StackPanel Orientation="Horizontal">
               <TextBlock Style="{StaticResource LayerNumber}"
                          Text="0"/>
               <TextBlock Style="{StaticResource LayerName}"
                          Text="{loc:Loc Label_LayerVault}"/>
               <Button Style="{StaticResource NotchIconButton}"
                       Content="&#xE946;"
                       AutomationProperties.Name="{Binding UserId}"
                       Click="_copyUserId_Click">
                  <Button.ToolTip>
                     <StackPanel>
                        <TextBlock FontFamily="{StaticResource MonoFontFamily}"
                                   Text="{Binding UserId}"/>
                        <TextBlock Margin="0,4,0,0"
                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                   Text="{loc:Loc Tooltip_CopyItemId}"/>
                     </StackPanel>
                  </Button.ToolTip>
               </Button>
            </StackPanel>
         </GroupBox.Header>
         <Grid>
            <Grid.RowDefinitions>
               <RowDefinition Height="Auto"/>
               <RowDefinition Height="Auto"/>
               <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
               <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
               </Grid.ColumnDefinitions>
               <Label Grid.Column="0"
                      Content="{loc:Loc Label_Service}"/>
               <TextBox Name="_serviceFilter_TB"
                        Grid.Column="1"
                        Text="{Binding ServiceFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
               <Label Grid.Column="2"
                      Margin="12,4,4,4"
                      Content="{loc:Loc Label_Identifier}"/>
               <ComboBox Grid.Column="3"
                         MinWidth="56"
                         VerticalAlignment="Center"
                         ItemsSource="{Binding TypeChoices}"
                         SelectedValue="{Binding Type, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         SelectedValuePath="Type"
                         DisplayMemberPath="Display"
                         ToolTip="{Binding TypeLabel}"/>
               <TextBox Grid.Column="4"
                        Style="{StaticResource MonoTextBox}"
                        Text="{Binding IdentifierFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
               <Label Grid.Column="5"
                      Margin="12,4,4,4"
                      Content="{loc:Loc Label_Text}"/>
               <TextBox Grid.Column="6"
                        Text="{Binding TextFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
               <CheckBox Grid.Column="7"
                         Margin="12,4,4,4"
                         Content="{loc:Loc Label_UnsavedItemsOnly}"
                         IsChecked="{Binding ChangedItemsOnly, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
               <Button Grid.Column="8"
                       Style="{StaticResource GhostIconButton}"
                       Content="&#xE894;"
                       ToolTip="{loc:Loc Tooltip_ClearFilters}"
                       AutomationProperties.Name="{loc:Loc Tooltip_ClearFilters}"
                       Command="{Binding ClearFiltersCommand}"/>
            </Grid>

            <Rectangle Grid.Row="1"
                       Height="1"
                       Margin="-12,8,-12,12"
                       Fill="{DynamicResource SubtleBorderBrush}"/>

            <Grid Grid.Row="2">
               <Grid.RowDefinitions>
                  <RowDefinition Height="*"/>
                  <RowDefinition Height="Auto"/>
               </Grid.RowDefinitions>
               <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="200"/>
                  <ColumnDefinition Width="*"/>
               </Grid.ColumnDefinitions>
               <ListBox Grid.Row="0"
                        Grid.Column="0"
                        Name="_services_LB"
                        ItemsSource="{Binding Services}"
                        SelectedItem="{Binding SelectedService, Mode=TwoWay}"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        ScrollViewer.CanContentScroll="True"
                        ScrollViewer.IsDeferredScrollingEnabled="True"
                        VirtualizingStackPanel.IsVirtualizing="True"
                        VirtualizingStackPanel.VirtualizationMode="Recycling"
                        SelectionChanged="_services_LB_SelectionChanged">
                  <ListBox.ItemTemplate>
                     <DataTemplate>
                        <TextBlock Text="{Binding ServiceDisplay}"
                                   TextTrimming="CharacterEllipsis"/>
                     </DataTemplate>
                  </ListBox.ItemTemplate>
               </ListBox>
               <DockPanel Grid.Row="1"
                          Grid.Column="0"
                          Margin="0,8,0,0">
                  <Button DockPanel.Dock="Left"
                          Style="{StaticResource IconButton}"
                          Margin="0,0,4,0"
                          Command="{Binding AddServiceCommand}"
                          ToolTip="{loc:Loc Tooltip_AddService}"
                          AutomationProperties.Name="{loc:Loc Tooltip_AddService}"
                          Content="&#xE710;"/>
                  <Button DockPanel.Dock="Right"
                          HorizontalAlignment="Right"
                          Style="{StaticResource IconButton}"
                          Margin="0"
                          Command="{Binding DeleteServiceCommand}"
                          ToolTip="{loc:Loc Tooltip_DeleteService}"
                          AutomationProperties.Name="{loc:Loc Tooltip_DeleteService}"
                          Content="&#xE74D;"/>
               </DockPanel>
               <Controls:ServiceView x:Name="_service_SV"
                                     Grid.Row="0"
                                     Grid.RowSpan="2"
                                     Grid.Column="1"
                                     Margin="12,0,0,0"/>
            </Grid>
         </Grid>
      </GroupBox>

      <!-- Depth bar: where you are in the layers, the paste shortcuts, and
           what kind of vault this is. -->
      <Border Grid.Row="2"
              Height="30"
              BorderBrush="{DynamicResource SubtleBorderBrush}"
              BorderThickness="0,1,0,0">
         <DockPanel Margin="16,0"
                    LastChildFill="False">
            <StackPanel DockPanel.Dock="Left"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
               <StackPanel Orientation="Horizontal"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0">
                  <Rectangle Width="14" Height="3" Margin="0,0,2,0" Fill="{DynamicResource AccentBrush}"/>
                  <Rectangle Width="14" Height="3" Margin="0,0,2,0" Fill="{DynamicResource AccentBrush}"/>
                  <Rectangle Width="14" Height="3" Margin="0,0,2,0" Fill="{DynamicResource AccentBrush}"/>
                  <Rectangle Width="14" Height="3" Fill="{DynamicResource AccentBrush}"/>
               </StackPanel>
               <TextBlock FontSize="11"
                          VerticalAlignment="Center">
                  <Run Text="{loc:Loc Label_LayerVault}"/>
                  <Run Foreground="{DynamicResource MutedForegroundBrush}" Text="›"/>
                  <Run Text="{Binding SelectedService.ServiceName, Mode=OneWay}"/>
                  <Run Foreground="{DynamicResource MutedForegroundBrush}" Text="›"/>
                  <Run Text="{Binding SelectedService.SelectedAccount.Label, Mode=OneWay}"/>
                  <Run Foreground="{DynamicResource MutedForegroundBrush}" Text="›"/>
                  <Run Text="{loc:Loc Label_PasswordGroup}"/>
               </TextBlock>
               <TextBlock Margin="20,0,0,0"
                          VerticalAlignment="Center"
                          FontSize="11"
                          Foreground="{DynamicResource MutedForegroundBrush}"
                          Text="{loc:Loc Msg_PasteHotkeys}"/>
            </StackPanel>
            <TextBlock DockPanel.Dock="Right"
                       VerticalAlignment="Center"
                       FontFamily="{StaticResource MonoFontFamily}"
                       FontSize="10"
                       Foreground="{DynamicResource MutedForegroundBrush}"
                       Text="{loc:Loc Label_LocalVault}"/>
         </DockPanel>
      </Border>
   </Grid>
</Window>
