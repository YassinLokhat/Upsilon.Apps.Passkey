<UserControl x:Class="Upsilon.Apps.Passkey.GUI.WPF.Views.Controls.VisiblePasswordBox"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Upsilon.Apps.Passkey.GUI.WPF.Views.Controls"
             xmlns:controls="clr-namespace:Upsilon.Apps.Passkey.GUI.WPF.ViewModels.Controls"
             xmlns:loc="clr-namespace:Upsilon.Apps.Passkey.GUI.WPF.Localization"
             d:DataContext="{d:DesignInstance Type=controls:VisiblePasswordBoxViewModel}"
             mc:Ignorable="d">
   <!-- DataContext is set on this grid (not the UserControl) so parent bindings
        such as Background="{Binding PasswordBackground}" keep working. -->
   <Grid Name="_root">
      <Grid.ColumnDefinitions>
         <ColumnDefinition Width="*"/>
         <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <PasswordBox Margin="0"
                   Grid.Column="0"
                   Name="_passwordBox"
                   PasswordChar="●"
                   FontFamily="{StaticResource MonoFontFamily}"
                   FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   Background="{Binding Background}"
                   IsEnabled="{Binding IsEnabled}"
                   Visibility="{Binding PasswordVisibility}"/>
      <TextBox Margin="0"
               Grid.Column="0"
               Style="{StaticResource MonoTextBox}"
               FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
               Visibility="{Binding TextVisibility}"
               Background="{Binding Background}"
               IsReadOnly="True"
               Text="{Binding RevealText}"/>
      <!-- Hold to reveal: the secret is shown only while the button is pressed. -->
      <!-- Attached to the field (design: field + square reveal button). -->
      <Button Margin="-1,0,0,0"
              Grid.Column="1"
              Style="{StaticResource IconButton}"
              Height="Auto"
              Width="{Binding ActualHeight, ElementName=_root}"
              Visibility="{Binding ButtonVisibility}"
              ToolTip="{loc:Loc Tooltip_RevealPassword}"
              AutomationProperties.Name="{loc:Loc Tooltip_RevealPassword}"
              PreviewMouseDown="_viewButton_MouseDown"
              PreviewMouseUp="_viewButton_MouseUp">
         <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Eye}"/>
      </Button>
   </Grid>
</UserControl>
