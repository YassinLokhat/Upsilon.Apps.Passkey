<UserControl x:Class="Upsilon.Apps.Passkey.GUI.WPF.Views.Controls.VisiblePasswordBox"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Upsilon.Apps.Passkey.GUI.WPF.Views.Controls"
             xmlns:controls="clr-namespace:Upsilon.Apps.Passkey.GUI.Presentation.ViewModels.Controls;assembly=Upsilon.Apps.Passkey.GUI.Presentation"
             xmlns:loc="clr-namespace:Upsilon.Apps.Passkey.GUI.WPF.Localization"
             d:DataContext="{d:DesignInstance Type=controls:SecretField}"
             mc:Ignorable="d">
   <!-- DataContext is set on this grid (not the UserControl) so parent bindings
        such as Background="{Binding PasswordBackground}" keep working. -->
   <Grid Name="_root" IsVisibleChanged="_root_IsVisibleChanged">
      <Grid.ColumnDefinitions>
         <ColumnDefinition Width="*"/>
         <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <PasswordBox Margin="1"
                   Grid.Column="0"
                   Name="_passwordBox"
                   PasswordChar="¤"
                   Background="{Binding Background, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   IsEnabled="{Binding IsEnabled}"
                   Visibility="{Binding IsRevealed, Converter={StaticResource InverseBoolToVisibility}}"/>
      <TextBox Margin="1"
               Grid.Column="0"
               Visibility="{Binding IsRevealed, Converter={StaticResource BoolToVisibility}}"
               Background="{Binding Background, RelativeSource={RelativeSource AncestorType=UserControl}}"
               IsReadOnly="True"
               Focusable="False"
               IsUndoEnabled="False"
               ContextMenuService.IsEnabled="False"
               Text="{Binding RevealText, Mode=OneWay}"/>
      <Button Margin="1"
              Grid.Column="1"
              FontFamily="Courier New"
              Content="👁"
              ToolTip="{loc:Loc Tooltip_RevealPassword}"
              PreviewMouseDown="_viewButton_MouseDown"
              PreviewMouseUp="_viewButton_MouseUp"
              LostMouseCapture="_viewButton_LostMouseCapture"/>
   </Grid>
</UserControl>
