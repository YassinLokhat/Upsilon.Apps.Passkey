<UserControl x:Class="Upsilon.Apps.Passkey.GUI.WPF.Views.Controls.UserPasswordItem"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Upsilon.Apps.Passkey.GUI.WPF.Views.Controls"
             xmlns:controls="clr-namespace:Upsilon.Apps.Passkey.GUI.WPF.ViewModels.Controls"
             xmlns:loc="clr-namespace:Upsilon.Apps.Passkey.GUI.WPF.Localization"
             d:DataContext="{d:DesignInstance Type=controls:UserPasswordItemViewModel}"
             mc:Ignorable="d">
   <Grid>
      <Grid.ColumnDefinitions>
         <ColumnDefinition Width="Auto"/>
         <ColumnDefinition Width="*"/>
         <ColumnDefinition Width="Auto"/>
         <ColumnDefinition Width="Auto"/>
         <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Label Grid.Column="0"
             Content="{Binding Index}"/>
      <local:VisiblePasswordBox x:Name="_password_VPB"
                                Margin="5"
                                Grid.Column="1"
                                Background="{Binding PasswordBackground}"/>
      <Button Grid.Column="2"
              Content="🠉"
              ToolTip="{loc:Loc Tooltip_MoveUp}"
              Command="{Binding UpCommand}"/>
      <Button Grid.Column="3"
              Content="🠋"
              ToolTip="{loc:Loc Tooltip_MoveDown}"
              Command="{Binding DownCommand}"/>
      <Button Grid.Column="4"
              Content="✕"
              ToolTip="{loc:Loc Tooltip_DeletePassword}"
              Command="{Binding DeleteCommand}"/>
   </Grid>
</UserControl>
