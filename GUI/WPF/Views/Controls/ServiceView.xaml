<UserControl x:Class="Upsilon.Apps.Passkey.GUI.WPF.Views.Controls.ServiceView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Upsilon.Apps.Passkey.GUI.WPF.Views.Controls"
             xmlns:controls="clr-namespace:Upsilon.Apps.Passkey.GUI.WPF.ViewModels.Controls"
             xmlns:loc="clr-namespace:Upsilon.Apps.Passkey.GUI.WPF.Localization"
             d:DataContext="{d:DesignInstance Type=controls:ServiceViewModel}"
             mc:Ignorable="d">
   <!-- Layer 1: the selected service. Its fields on top, its accounts on the
        left, the account layer nested on the right. -->
   <GroupBox Style="{StaticResource LayerGroupBox}"
             Background="{DynamicResource Layer1Brush}">
      <GroupBox.Header>
         <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource LayerNumber}"
                       Text="1"/>
            <TextBlock Style="{StaticResource LayerName}"
                       Text="{loc:Loc Label_LayerService}"/>
            <Button Style="{StaticResource NotchIconButton}"
                    Content="&#xE946;"
                    AutomationProperties.Name="{Binding ServiceId}"
                    Click="_copyServiceId_Click">
               <Button.ToolTip>
                  <StackPanel>
                     <TextBlock FontFamily="{StaticResource MonoFontFamily}"
                                Text="{Binding ServiceId}"/>
                     <TextBlock Margin="0,4,0,0"
                                Foreground="{DynamicResource MutedForegroundBrush}"
                                Text="{loc:Loc Tooltip_CopyItemId}"/>
                  </StackPanel>
               </Button.ToolTip>
            </Button>
         </StackPanel>
      </GroupBox.Header>
      <Grid>
         <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
         </Grid.RowDefinitions>
         <Grid Grid.Row="0">
            <Grid.RowDefinitions>
               <RowDefinition Height="Auto"/>
               <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
               <ColumnDefinition Width="Auto"/>
               <ColumnDefinition Width="2*"/>
               <ColumnDefinition Width="Auto"/>
               <ColumnDefinition Width="3*"/>
               <ColumnDefinition Width="Auto"/>
               <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Label Grid.Row="0"
                   Grid.Column="0"
                   Content="{loc:Loc Label_ServiceName}"/>
            <TextBox Grid.Row="0"
                     Grid.Column="1"
                     FontWeight="SemiBold"
                     Text="{Binding ServiceName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Background="{Binding ServiceNameBackground}"/>
            <Label Grid.Row="0"
                   Grid.Column="2"
                   Margin="12,4,4,4"
                   Content="{loc:Loc Label_Url}"/>
            <TextBox Grid.Row="0"
                     Grid.Column="3"
                     Style="{StaticResource MonoTextBox}"
                     Text="{Binding Url, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Background="{Binding UrlBackground}"/>
            <Button Grid.Row="0"
                    Grid.Column="4"
                    Style="{StaticResource IconButton}"
                    Content="&#xE774;"
                    ToolTip="{loc:Loc Tooltip_OpenUrl}"
                    AutomationProperties.Name="{loc:Loc Tooltip_OpenUrl}"
                    Command="{Binding OpenUrlCommand}"/>
            <Button Grid.Row="0"
                    Grid.Column="5"
                    Style="{StaticResource IconButton}"
                    Content="&#xE81C;"
                    ToolTip="{loc:Loc Tooltip_ViewActivities}"
                    AutomationProperties.Name="{loc:Loc Tooltip_ViewActivities}"
                    Command="{Binding ViewActivitiesCommand}"/>
            <Label Grid.Row="1"
                   Grid.Column="0"
                   Content="{loc:Loc Label_Notes}"/>
            <TextBox Grid.Row="1"
                     Grid.Column="1"
                     Grid.ColumnSpan="5"
                     Text="{Binding Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Background="{Binding NotesBackground}"
                     MaxHeight="75"
                     VerticalScrollBarVisibility="Auto"
                     AcceptsReturn="True"
                     AcceptsTab="True"/>
         </Grid>

         <Rectangle Grid.Row="1"
                    Height="1"
                    Margin="-12,8,-12,12"
                    Fill="{DynamicResource SubtleBorderBrush}"/>

         <Grid Grid.Row="2">
            <Grid.RowDefinitions>
               <RowDefinition Height="*"/>
               <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
               <ColumnDefinition Width="190"/>
               <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ListBox Grid.Row="0"
                     Grid.Column="0"
                     Name="_accounts_LB"
                     ItemsSource="{Binding Accounts}"
                     SelectedItem="{Binding SelectedAccount, Mode=TwoWay}"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.CanContentScroll="True"
                     ScrollViewer.IsDeferredScrollingEnabled="True"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                     SelectionChanged="_accounts_LB_SelectionChanged">
               <ListBox.ItemTemplate>
                  <DataTemplate>
                     <TextBlock Text="{Binding AccountDisplay}"
                                TextTrimming="CharacterEllipsis"/>
                  </DataTemplate>
               </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Grid.Row="1"
                        Grid.Column="0"
                        Margin="0,8,0,0"
                        Orientation="Horizontal">
               <Button Style="{StaticResource IconButton}"
                       Margin="0,0,4,0"
                       Command="{Binding AddAccountCommand}"
                       ToolTip="{loc:Loc Tooltip_AddAccount}"
                       AutomationProperties.Name="{loc:Loc Tooltip_AddAccount}"
                       Content="&#xE710;"/>
               <Button Style="{StaticResource IconButton}"
                       Margin="0,0,4,0"
                       Content="&#xE74A;"
                       ToolTip="{loc:Loc Tooltip_MoveUp}"
                       AutomationProperties.Name="{loc:Loc Tooltip_MoveUp}"
                       Command="{Binding MoveAccountUpCommand}"/>
               <Button Style="{StaticResource IconButton}"
                       Margin="0,0,4,0"
                       Command="{Binding MoveAccountDownCommand}"
                       ToolTip="{loc:Loc Tooltip_MoveDown}"
                       AutomationProperties.Name="{loc:Loc Tooltip_MoveDown}"
                       Content="&#xE74B;"/>
               <Button Style="{StaticResource IconButton}"
                       Margin="0"
                       Command="{Binding DeleteAccountCommand}"
                       ToolTip="{loc:Loc Tooltip_DeleteAccount}"
                       AutomationProperties.Name="{loc:Loc Tooltip_DeleteAccount}"
                       Content="&#xE74D;"/>
            </StackPanel>
            <local:AccountView x:Name="_account_AV"
                               Grid.Row="0"
                               Grid.RowSpan="2"
                               Grid.Column="1"
                               Margin="12,0,0,0"/>
         </Grid>
      </Grid>
   </GroupBox>
</UserControl>
