<Window xmlns:Controls="clr-namespace:Upsilon.Apps.Passkey.GUI.WPF.Views.Controls"
        x:Class="Upsilon.Apps.Passkey.GUI.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Upsilon.Apps.Passkey.GUI.WPF"
        xmlns:viewmodels="clr-namespace:Upsilon.Apps.Passkey.GUI.WPF.ViewModels"
        d:DataContext="{d:DesignInstance Type=viewmodels:MainViewModel}"
        mc:Ignorable="d"
        Title="{Binding AppTitle}"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Height="150" Width="500">
    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenDatabaseCommand}"/>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewUserCommand}"/>
        <KeyBinding Key="P" Modifiers="Control" Command="{Binding GeneratePasswordCommand}"/>
    </Window.InputBindings>
    <StackPanel>
        <Menu>
            <Menu.ItemsPanel>
                <ItemsPanelTemplate>
                    <DockPanel HorizontalAlignment="Stretch"/>
                </ItemsPanelTemplate>
            </Menu.ItemsPanel>
            <MenuItem Header="_Open database"
                      Command="{Binding OpenDatabaseCommand}"
                      InputGestureText="Ctrl+O"/>
            <MenuItem Header="_New User"
                      Command="{Binding NewUserCommand}"
                      InputGestureText="Ctrl+N"/>
            <MenuItem Header="_Generate random Password"
                      Command="{Binding GeneratePasswordCommand}"
                      HorizontalAlignment="Right"/>
        </Menu>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Grid.Row="1"
                   Grid.Column="0"
                   Grid.ColumnSpan="2">
                <TextBlock Text="{Binding DatabaseLabel}"
                    TextWrapping="Wrap" />
            </Label>
            <Label Grid.Row="0"
                   Grid.Column="0"
                   MinWidth="70"
                   Content="{Binding CredentialsLabel}"/>
            <TextBox Name="_username_TB"
                     Grid.Row="0"
                     Grid.Column="1"
                     Visibility="Visible"/>
            <PasswordBox Name="_password_PB"
                         Grid.Row="0"
                         Grid.Column="1"
                         Visibility="Collapsed"/>
        </Grid>
    </StackPanel>
</Window>
