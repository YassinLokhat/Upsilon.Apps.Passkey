<Window xmlns:Controls="clr-namespace:Upsilon.Apps.Passkey.GUI.WPF.Views.Controls"
        x:Class="Upsilon.Apps.Passkey.GUI.WPF.MainWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Upsilon.Apps.Passkey.GUI.WPF"
        xmlns:viewmodels="clr-namespace:Upsilon.Apps.Passkey.GUI.WPF.ViewModels"
        xmlns:loc="clr-namespace:Upsilon.Apps.Passkey.GUI.WPF.Localization"
        d:DataContext="{d:DesignInstance Type=viewmodels:MainViewModel}"
        mc:Ignorable="d"
        Title="{Binding AppTitle}"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Height="140" Width="750">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="_booleanToVisibility"/>
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenDatabaseCommand}"/>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewUserCommand}"/>
        <KeyBinding Key="OemComma" Modifiers="Control" Command="{Binding AppSettingsCommand}"/>
        <KeyBinding Key="P" Modifiers="Control" Command="{Binding GeneratePasswordCommand}"/>
    </Window.InputBindings>
    <StackPanel>
        <Menu IsEnabled="{Binding MenusEnabled}">
            <Menu.ItemsPanel>
                <ItemsPanelTemplate>
                    <DockPanel HorizontalAlignment="Stretch"/>
                </ItemsPanelTemplate>
            </Menu.ItemsPanel>
            <MenuItem Header="{loc:Loc Menu_OpenDatabase}"
                      Command="{Binding OpenDatabaseCommand}"
                      InputGestureText="Ctrl+O"/>
            <MenuItem Header="{loc:Loc Menu_NewUser}"
                      Command="{Binding NewUserCommand}"
                      InputGestureText="Ctrl+N"/>
            <MenuItem Header="{loc:Loc Menu_AppSettings}"
                      Command="{Binding AppSettingsCommand}"
                      InputGestureText="Ctrl+,"/>
            <MenuItem Header="{loc:Loc Menu_GenerateRandomPassword}"
                      Command="{Binding GeneratePasswordCommand}"
                      InputGestureText="Ctrl+P"
                      HorizontalAlignment="Right"/>
        </Menu>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Grid.Row="1"
                   Grid.Column="0"
                   Grid.ColumnSpan="2">
                <TextBlock Text="{Binding DatabaseLabel}"
                    TextWrapping="Wrap" />
            </Label>
            <Label Grid.Row="0"
                   Grid.Column="0"
                   MinWidth="70"
                   Content="{Binding CredentialsLabel}"/>
            <TextBox Name="_username_TB"
                     Grid.Row="0"
                     Grid.Column="1"
                     Visibility="Visible"
                     IsEnabled="{Binding MenusEnabled}"/>
            <PasswordBox Name="_password_PB"
                         Grid.Row="0"
                         Grid.Column="1"
                         Visibility="Collapsed"
                         IsEnabled="{Binding CanTypePasskey}"/>
            <StackPanel Grid.Row="2"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Margin="5,0,5,0"
                        Visibility="{Binding IsBusy, Converter={StaticResource _booleanToVisibility}}">
                <TextBlock Text="{Binding BusyMessage}"
                           TextWrapping="Wrap"/>
                <ProgressBar IsIndeterminate="True"
                             Height="6"
                             Margin="0,3,0,0"/>
            </StackPanel>
        </Grid>
    </StackPanel>
</Window>
