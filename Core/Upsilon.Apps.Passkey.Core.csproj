<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>A local stored Password Manager Core.</Description>
    <Version>2.0.0</Version>
    <AssemblyVersion>2.0.0</AssemblyVersion>
    <FileVersion>2.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Interfaces\Upsilon.Apps.Passkey.Interfaces.csproj" />
    <ProjectReference Include="..\Utils\Upsilon.Apps.Passkey.Utils.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="UnitTests" />
  </ItemGroup>

  <!--
    Zero-dependency policy: the Core library must never take on a third-party
    NuGet package, to keep the security-critical supply-chain attack surface
    minimal. ProjectReferences (in-solution) stay allowed. This target turns
    the policy into a hard build failure.
  -->
  <Target Name="EnforceZeroExternalDependencies" BeforeTargets="Build;Pack">
    <Error Condition="'@(PackageReference)' != ''" Text="Zero-dependency policy violated in '$(MSBuildProjectName)': external NuGet packages are not allowed (found: @(PackageReference))." />
  </Target>

</Project>
